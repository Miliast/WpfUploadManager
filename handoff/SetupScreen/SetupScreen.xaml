<!--
    SetupScreen – the "New run" setup screen of Conduit as ONE self-contained WPF UserControl (this file + SetupScreen.xaml.cs).
    Paper: "1e · Variant A — hint in the field, same row" (empty), "2c · Variant A — filled", "16 · Path field — states".

    ┌─ top bar (56) ──────────────────────────────────────────────────────────────────────────────────────────────┐
    │ ▣ Conduit / New run                                             5 files missing   [ ▶ Run pipelines ]      │
    ├─ sidebar (300, on the grey shell) ─┬─ sheet (white, radius 14, 8 px from the right / bottom) ───────────────┤
    │ PROJECT                            │   Set up the run.                                   ( Node | Python )  │
    │                                    │   Add the five files below, or drop them anywhere on this page.         │
    │   skeleton tree                    │  ╭──────────────────────────────────────────────────────────────────╮  │
    │   Open your project                │  │ ┆▢┆ Test folder       ( Specs for all nodes             [Browse]) │  │
    │   [ Open folder  Ctrl+O ]          │  │ ┆▢┆ Project manifest  ( package.json                    [Browse]) │  │
    │   Try a sample project             │  │ ┆▢┆ Source file       ( .ts, .tsx or .js                [Browse]) │  │
    │                                    │  │ ┆▢┆ Container         ( Dockerfile                      [Browse]) │  │
    │ (with a project: name · n files,   │  │ ┆▢┆ Pipeline config   ( .yml or .yaml                   [Browse]) │  │
    │  filter box, file tree, auto-fill) │  ╰──────────────────────────────────────────────────────────────────╯  │
    │                                    │  ╭ ┆☁┆ Get data from X          For Gen X · from BAX  [⭳ Import] ╮    │
    │                                    │  ╰──────────────────────────────────────────────────────────────────╯  │
    │                                    │   ⓘ Tip: open the whole project folder in the sidebar …                 │
    └────────────────────────────────────┴─────────────────────────────────────────────────────────────────────────┘

    One idea runs through the screen: the blue "Run pipelines" is the ONLY filled, coloured button on the white sheet.
    Everything else (Browse, Import, Refresh) is white with a hairline; the two black buttons live in the sidebar.

    Every field can be filled four ways: type or paste a path, "Browse", drag a file from the sidebar tree or from
    Explorer onto the field, or drop files anywhere on the sheet (each goes into its matching field).

    Requirements: WPF, net8.0-windows or later, C# 12, no NuGet packages. Namespace "Conduit.Setup" – rename it here
    (x:Class, xmlns:local) and at the top of SetupScreen.xaml.cs together. Everything the screen needs (colours, fonts,
    icons, styles, templates) is in UserControl.Resources below; nothing comes from App.xaml.
    Not included on purpose: window buttons (minimise / maximise / close belong to the host window), the animated
    mode switch and the auto-fill glow of the Conduit demo.
-->
<UserControl x:Class="Conduit.Setup.SetupScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Conduit.Setup"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#000000"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewKeyDown="OnPreviewKeyDown">

    <UserControl.Resources>

        <!-- ══ Colours ═══════════════════════════════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Blue" Color="#1F4BFF" />
        <SolidColorBrush x:Key="BlueHover" Color="#1A40E0" />
        <SolidColorBrush x:Key="BlueSoft" Color="#F3F6FF" />
        <SolidColorBrush x:Key="BlueRing" Color="#C9D4FF" />
        <SolidColorBrush x:Key="BlueLight" Color="#7D97FF" />
        <SolidColorBrush x:Key="Ink" Color="#0B0D12" />
        <SolidColorBrush x:Key="InkHover" Color="#2A2E38" />
        <SolidColorBrush x:Key="Black" Color="#000000" />
        <SolidColorBrush x:Key="Muted" Color="#5B6270" />
        <SolidColorBrush x:Key="Subtle" Color="#8A909C" />
        <SolidColorBrush x:Key="Faint" Color="#A0A6B1" />
        <SolidColorBrush x:Key="Faintest" Color="#B4B9C3" />
        <SolidColorBrush x:Key="Dashed" Color="#C9CDD3" />
        <SolidColorBrush x:Key="Skeleton" Color="#D5D9E0" />
        <SolidColorBrush x:Key="SkeletonLight" Color="#E1E4E9" />
        <SolidColorBrush x:Key="Hairline" Color="#E3E5E8" />
        <SolidColorBrush x:Key="Line" Color="#E6E8EC" />
        <SolidColorBrush x:Key="LineSoft" Color="#F0F1F3" />
        <SolidColorBrush x:Key="Chip" Color="#F2F3F5" />
        <SolidColorBrush x:Key="Hover" Color="#F6F7F9" />
        <SolidColorBrush x:Key="Shell" Color="#E6E7EB" />
        <SolidColorBrush x:Key="Track" Color="#E8EAED" />
        <SolidColorBrush x:Key="SheetLine" Color="#140B0D12" />
        <SolidColorBrush x:Key="CardLine" Color="#170B0D12" />
        <SolidColorBrush x:Key="Green" Color="#12A150" />
        <SolidColorBrush x:Key="RedText" Color="#C2262A" />
        <SolidColorBrush x:Key="RedLine" Color="#F3CACB" />
        <SolidColorBrush x:Key="Purple" Color="#7A3FE4" />

        <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <local:VisibleWhen x:Key="VisibleWhen" />
        <local:VisibleWhen x:Key="CollapsedWhen" Invert="True" />

        <!-- ══ Icons: SVG path data from Paper (viewBox 14 unless the comment says otherwise) ═══════ -->
        <Geometry x:Key="Geo.Folder">M2.5,4.5 A1,1 0 0 1 3.5,3.5 H6.5 L8,5 H12.5 A1,1 0 0 1 13.5,6 V12 A1,1 0 0 1 12.5,13 H3.5 A1,1 0 0 1 2.5,12 Z</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.Spec">M6,2.5 H10 M7,2.5 V6.5 L3.5,13 H12.5 L9,6.5 V2.5</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.Doc">M4,2.5 H9 L12,5.5 V13.5 H4 Z</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.Container">M4.5,5 H11.5 A1.5,1.5 0 0 1 13,6.5 V10.5 A1.5,1.5 0 0 1 11.5,12 H4.5 A1.5,1.5 0 0 1 3,10.5 V6.5 A1.5,1.5 0 0 1 4.5,5 Z M5,5 V3.5 H11 V5</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.ChevronDown">M2.5,4 L5,6.5 L7.5,4</Geometry><!-- 10 -->
        <Geometry x:Key="Geo.ChevronRight">M3.5,2 L6.5,5 L3.5,8</Geometry><!-- 10 -->
        <Geometry x:Key="Geo.Play">M2,1.5 V8.5 L8,5 Z</Geometry><!-- 10, filled -->
        <Geometry x:Key="Geo.Search">M6,2 A4,4 0 1 1 6,10 A4,4 0 1 1 6,2 Z M9,9 L12,12</Geometry>
        <Geometry x:Key="Geo.Upload">M7,9.5 V3 M4.5,5.5 L7,3 L9.5,5.5 M2.5,10 V11 A0.5,0.5 0 0 0 3,11.5 H11 A0.5,0.5 0 0 0 11.5,11 V10</Geometry>
        <Geometry x:Key="Geo.Download">M7,2.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2.5,10 V11 A0.5,0.5 0 0 0 3,11.5 H11 A0.5,0.5 0 0 0 11.5,11 V10</Geometry>
        <Geometry x:Key="Geo.Refresh">M2.5,7 A4.5,4.5 0 1 0 3.8,3.8 M2.5,2.5 V5 H5</Geometry>
        <Geometry x:Key="Geo.Cloud">M5,12.5 A3.5,3.5 0 0 1 4.6,5.5 A4.5,4.5 0 0 1 13.3,6 A3.25,3.25 0 0 1 13,12.5 M9,8.5 V14.5 M6.8,12.3 L9,14.5 L11.2,12.3</Geometry><!-- 18 -->
        <Geometry x:Key="Geo.Info">M7,1.5 A5.5,5.5 0 1 1 7,12.5 A5.5,5.5 0 1 1 7,1.5 Z M7,6.2 V9.5 M7,4.4 V4.5</Geometry>
        <Geometry x:Key="Geo.Sparkle">M7,1 Q7.6,6.4 13,7 Q7.6,7.6 7,13 Q6.4,7.6 1,7 Q6.4,6.4 7,1 Z</Geometry><!-- filled -->
        <Geometry x:Key="Geo.Check8">M1.5,4.2 L3.2,5.8 L6.5,2.4</Geometry><!-- 8 -->

        <!-- ══ Text styles ═══════════════════════════════════════════════════════════════════════════ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SkeletonBar" TargetType="Border">
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- ══ Buttons ═══════════════════════════════════════════════════════════════════════════════
             One flat template; each variant only sets colours, radius (local:Look.CornerRadius) and hover. -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Black}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                CornerRadius="{Binding (local:Look.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Blue "Run pipelines" – the one strong button. Disabled: grey on the grey top bar. -->
        <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Blue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="local:Look.CornerRadius" Value="9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#D9DBE0" />
                    <Setter Property="Foreground" Value="#9AA0AB" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Black "Open folder", "Auto-fill" – sidebar only. -->
        <Style x:Key="Btn.Dark" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="local:Look.CornerRadius" Value="9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource InkHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Chip}" />
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- White with hairline: "Import" / "Refresh" on the X card (96 × 30). -->
        <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="local:Look.CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Small white "Browse" at the right end of a path field (26 high, radius 7). Hover one shade darker than
             Btn.Outline's, because the field around it already is the light Hover grey. -->
        <Style x:Key="Btn.Mini" TargetType="Button" BasedOn="{StaticResource Btn.Outline}">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="local:Look.CornerRadius" Value="7" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Chip}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text link: blue ("Try a sample project", "Replace"). -->
        <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1233C4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- One half of the Node | Python switch: transparent pill; the checked one turns white with a soft edge. -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill" Height="28" Padding="18,0" CornerRadius="14" Background="Transparent" BorderThickness="1"
                                BorderBrush="Transparent">
                            <TextBlock x:Name="Label" Text="{TemplateBinding Content}" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="White" />
                                <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Hairline}" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource Black}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bare text box inside a path field – the field's Border draws fill and ring, the box only the mono text and a blue caret. -->
        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="CaretBrush" Value="{StaticResource Blue}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Blue}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <!-- Slim scroll bars (tree and sheet). -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{StaticResource Skeleton}" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Faintest}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════════
             SIDEBAR TREE ROW – one file or folder of the open project
             ═══════════════════════════════════════════════════════════════════════════════════════
             28 high, radius 6, 8 px side padding. Lanes: indent (16 per level) · chevron 10 (folders only; files keep
             the slot) · glyph 14 · name · note right-aligned (the field the file is used for, or a folder's entry count).
             Hover = Chip. Folders toggle on click; files and folders can be dragged onto a field. -->
        <DataTemplate x:Key="TreeRowTemplate" DataType="{x:Type local:TreeRow}">
            <Border x:Name="Row" Height="28" CornerRadius="6" Padding="8,0" Margin="0,0,0,1"
                    MouseLeftButtonDown="OnTreeRowDown" MouseMove="OnTreeRowMove" MouseLeftButtonUp="OnTreeRowUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="SizeAll" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Chip}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDir}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                    <local:PathIcon x:Name="Chevron" DockPanel.Dock="Left" Data="{StaticResource Geo.ChevronRight}" Box="10" Width="10" Height="10"
                                    StrokeThickness="1.4" Foreground="{StaticResource Subtle}" />
                    <local:PathIcon x:Name="Glyph" DockPanel.Dock="Left" Box="16" Width="14" Height="14" Margin="6,0,0,0"
                                    Data="{StaticResource Geo.Doc}" Foreground="{StaticResource Green}" />
                    <TextBlock x:Name="Note" DockPanel.Dock="Right" Text="{Binding Note}" Margin="8,0,0,0" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Label" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDir}" Value="False">
                    <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDir}" Value="True">
                    <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Geo.ChevronDown}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoteIsCount}" Value="True">
                    <Setter TargetName="Note" Property="FontFamily" Value="{StaticResource Mono}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="Folder">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Folder}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="TestFolder">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Folder}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Glyph" Property="Filled" Value="True" />
                    <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="Spec">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Spec}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Purple}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="Container">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Container}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Blue}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═══════════════════════════════════════════════════════════════════════════════════════
             ONE INPUT FIELD – a 68 px row of the fields card (Paper variant A)
             ═══════════════════════════════════════════════════════════════════════════════════════
             A 1 px divider sits above every row but the first (72 px from the left, 16 from the right).
             Lanes inside the row (16 px side padding):
               glyph ....... 40 × 40 – folder: blue gradient folder, dashed outline while empty;
                             file: white page 30 × 38 with a coloured type tag (JSON, TS, DOCKER, YML, TXT), dashed + grey while empty
               name ........ 16 px after the glyph, 144 wide: the field's name, 14 SemiBold, one line ("Source file")
               path field .. 16 px after the name, fills the rest (company paths are long); 32 high, radius 9, no border
                               empty  → Hover fill, the field's hint as grey placeholder (".ts, .tsx or .js")
                               filled → path in mono Ink: relative inside the project, absolute outside it; too long →
                                        shortened in the middle (\\corp-fs01\platform\…\2026-q4\Dockerfile);
                                        size or spec count in grey before Browse ("106 B", "6 specs")
                               focus  → white, 1 px BlueRing, the full path to edit; Enter or leaving the field commits,
                                        Esc puts the old path back
                               error  → RedLine ring, the reason in red before Browse ("Not found")
                             right end: white "Browse" (26 high)
             While a file is dragged over the row: BlueSoft background, 1.5 px blue outline, blue "Drop to replace ci.yml"
             across the field's lane, path field hidden. The row listens with Preview events, because the text box
             would otherwise take the drag as text. -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type local:Slot}">
            <StackPanel>
                <Border x:Name="Divider" Height="1" Margin="72,0,16,0" Background="{StaticResource LineSoft}" />
                <Border x:Name="Row" Height="68" CornerRadius="10" Padding="16,0" BorderThickness="1.5" BorderBrush="Transparent"
                        Background="Transparent" AllowDrop="True"
                        PreviewDragEnter="OnFieldDragOver" PreviewDragOver="OnFieldDragOver" DragLeave="OnFieldDragLeave" PreviewDrop="OnFieldDrop">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="176" />
                            <ColumnDefinition Width="*" MinWidth="160" />
                        </Grid.ColumnDefinitions>

                        <Grid Width="40" Height="40">
                            <Grid x:Name="FolderGlyph" Height="34" Visibility="Collapsed">
                                <Grid x:Name="FolderFull">
                                    <Rectangle Width="18" Height="10" RadiusX="3" RadiusY="3" Fill="{StaticResource BlueLight}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Rectangle Height="29" RadiusX="7" RadiusY="7" VerticalAlignment="Bottom">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#5A7BFF" Offset="0" />
                                                <GradientStop Color="#1F4BFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#1F4BFF" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.35" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </Grid>
                                <Grid x:Name="FolderEmpty" Visibility="Collapsed">
                                    <Rectangle Width="18" Height="10" RadiusX="3" RadiusY="3" Stroke="{StaticResource Dashed}" StrokeThickness="1.5"
                                               StrokeDashArray="2 1.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Rectangle Height="29" RadiusX="7" RadiusY="7" VerticalAlignment="Bottom" Fill="White"
                                               Stroke="{StaticResource Dashed}" StrokeThickness="1.5" StrokeDashArray="2 1.4" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="FileGlyph">
                                <Border x:Name="Page" Width="30" Height="38" CornerRadius="6" Background="White"
                                        BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="6,7">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Color="#0B0D12" Opacity="0.06" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Width="14" Height="2" CornerRadius="1" Background="{StaticResource Line}" HorizontalAlignment="Left" />
                                        <Border Width="10" Height="2" CornerRadius="1" Background="{StaticResource Line}" HorizontalAlignment="Left" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Rectangle x:Name="PageEmpty" Width="30" Height="38" RadiusX="6" RadiusY="6" Visibility="Collapsed"
                                           Stroke="{StaticResource Dashed}" StrokeThickness="1.5" StrokeDashArray="2 1.4" />
                                <Border x:Name="TypeTag" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                        Padding="4,2" CornerRadius="4" Background="{Binding TagColor}">
                                    <TextBlock x:Name="TypeText" Text="{Binding Tag}" FontSize="8" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Grid>

                        <TextBlock x:Name="Title" Grid.Column="1" Text="{Binding DisplayTitle}" Margin="16,0" VerticalAlignment="Center"
                                   FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />

                        <!-- Path field. Three layers in the text lane: the grey hint (empty), the shortened path (filled, not
                             focused) and the text box itself, whose text only shows while it has focus. -->
                        <Border x:Name="Field" Grid.Column="2" Height="32" CornerRadius="9" BorderThickness="1" Padding="11,0,2,0"
                                VerticalAlignment="Center" Background="{StaticResource Hover}" BorderBrush="Transparent">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Mini}" Content="Browse" Click="OnBrowseField" />
                                <TextBlock x:Name="Meta" DockPanel.Dock="Right" Text="{Binding Meta}" Margin="8,0,8,0" FontSize="12"
                                           Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                                           Visibility="{Binding Meta, Converter={StaticResource VisibleWhen}}" />
                                <Grid>
                                    <TextBlock x:Name="Placeholder" Text="{Binding Hint}" Margin="2,0,0,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <local:CompactPath x:Name="ShortPath" Text="{Binding PathText}" Margin="2,0,0,0" IsHitTestVisible="False"
                                                       FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}" />
                                    <TextBox x:Name="PathBox" Style="{StaticResource PathBox}" Foreground="Transparent"
                                             Text="{Binding PathText, Mode=OneWay}"
                                             KeyDown="OnPathKeyDown" LostKeyboardFocus="OnPathLostFocus" />
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Index}" Value="0">
                    <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFilled}" Value="False">
                    <Setter TargetName="FolderFull" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FolderEmpty" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PageEmpty" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TypeTag" Property="Background" Value="{StaticResource Line}" />
                    <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource Subtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text, ElementName=PathBox}" Value="">
                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource RedLine}" />
                    <Setter TargetName="Meta" Property="Foreground" Value="{StaticResource RedText}" />
                    <Setter TargetName="Meta" Property="FontWeight" Value="Medium" />
                </DataTrigger>
                <!-- Editing: white field with the blue ring and the full path in the text box. -->
                <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=PathBox}" Value="True">
                    <Setter TargetName="Field" Property="Background" Value="White" />
                    <Setter TargetName="Field" Property="BorderBrush" Value="{StaticResource BlueRing}" />
                    <Setter TargetName="PathBox" Property="Foreground" Value="{StaticResource Ink}" />
                    <Setter TargetName="ShortPath" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource BlueSoft}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Blue}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Title" Property="Grid.ColumnSpan" Value="2" />
                    <Setter TargetName="Field" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- ══ Layout: grey shell with the top bar, the sidebar on the shell, and one white sheet ══════════════ -->
    <Grid Background="{StaticResource Shell}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ── Top bar: logo · "Conduit" 15 Bold · "/" · "New run" … status · Run pipelines (34 high) ───────── -->
        <DockPanel Margin="20,0,16,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Grid VerticalAlignment="Center">
                    <TextBlock Text="{Binding MissingText}" Foreground="{StaticResource Muted}"
                               Visibility="{Binding IsReady, Converter={StaticResource CollapsedWhen}}" />
                    <TextBlock Foreground="{StaticResource Muted}" Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                        <Run Text="Ready" Foreground="{StaticResource Green}" FontWeight="SemiBold" /><Run Text="{Binding ReadyText, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
                <Button Style="{StaticResource Btn.Primary}" Height="34" Padding="14,0,16,0" Margin="14,0,0,0"
                        IsEnabled="{Binding IsReady}" Click="OnRunClick" ToolTip="Ctrl+Enter">
                    <StackPanel Orientation="Horizontal">
                        <local:PathIcon Data="{StaticResource Geo.Play}" Box="10" Width="10" Height="10" Filled="True" />
                        <TextBlock Text="Run pipelines" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Ink}">
                    <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Blue}" />
                </Border>
                <TextBlock Text="Conduit" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="/" Margin="14,0" Foreground="{StaticResource Faintest}" VerticalAlignment="Center" />
                <TextBlock Text="New run" FontWeight="SemiBold" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1">

            <!-- ══ Sidebar: 300 wide, directly on the grey shell. Takes a dropped folder as the project. ═════════ -->
            <Border DockPanel.Dock="Left" Width="300" Background="Transparent"
                    AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop">
                <Grid>

                    <!-- No project yet: "PROJECT" top-left; centred block lifted 40 px above the middle – skeleton tree ·
                         title · two-line hint · black "Open folder" with its shortcut chip · blue "Try a sample project". -->
                    <Grid Visibility="{Binding HasProject, Converter={StaticResource CollapsedWhen}}">
                        <TextBlock Text="PROJECT" Style="{StaticResource SectionLabel}" Margin="20,22,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40">
                            <StackPanel Width="150" Opacity="0.9" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="10" CornerRadius="2" Background="{StaticResource Skeleton}" />
                                    <Border Width="70" Style="{StaticResource SkeletonBar}" Background="{StaticResource Skeleton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,7,0,0">
                                    <Border Width="10" Height="12" CornerRadius="2" Background="{StaticResource SkeletonLight}" />
                                    <Border Width="84" Style="{StaticResource SkeletonBar}" Background="{StaticResource SkeletonLight}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,7,0,0">
                                    <Border Width="10" Height="12" CornerRadius="2" Background="{StaticResource SkeletonLight}" />
                                    <Border Width="60" Style="{StaticResource SkeletonBar}" Background="{StaticResource SkeletonLight}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Border Width="12" Height="10" CornerRadius="2" Background="{StaticResource Skeleton}" />
                                    <Border Width="52" Style="{StaticResource SkeletonBar}" Background="{StaticResource Skeleton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,7,0,0">
                                    <Border Width="10" Height="12" CornerRadius="2" Background="{StaticResource SkeletonLight}" />
                                    <Border Width="76" Style="{StaticResource SkeletonBar}" Background="{StaticResource SkeletonLight}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Open your project" Margin="0,16,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Browse its files here, then drag them onto the fields." Margin="0,6,0,0" MaxWidth="230"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                                       HorizontalAlignment="Center" />

                            <Button Style="{StaticResource Btn.Dark}" Height="36" Padding="14,0,8,0" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Click="OnOpenFolder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" Background="#29FFFFFF" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl+O" FontFamily="{StaticResource Mono}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Link}" Content="Try a sample project" Margin="0,14,0,0" HorizontalAlignment="Center"
                                    Click="OnSample" />
                        </StackPanel>
                    </Grid>

                    <!-- With a project: name · "42 files" · Replace; filter box; the tree; footer with auto-fill + drag hint. -->
                    <DockPanel Visibility="{Binding HasProject, Converter={StaticResource VisibleWhen}}">
                        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Replace" FontSize="12" FontWeight="SemiBold"
                                        ToolTip="Open another folder (Ctrl+O)" Click="OnOpenFolder" />
                                <local:PathIcon Data="{StaticResource Geo.Folder}" Box="16" Width="16" Height="16" Filled="True"
                                                Foreground="{StaticResource Blue}" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,0" ClipToBounds="True">
                                    <TextBlock Text="{Binding ProjectName}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProjectFilesText}" Margin="8,1,0,0" FontFamily="{StaticResource Mono}" FontSize="11"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="30" Margin="0,10,0,0" Padding="10,0" CornerRadius="8" Background="White" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=FilterBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BlueRing}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <local:PathIcon Data="{StaticResource Geo.Search}" Width="13" Height="13" StrokeThickness="1.4"
                                                    Foreground="{StaticResource Subtle}" />
                                    <Grid Margin="8,0,0,0">
                                        <TextBlock Text="Filter files" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" IsHitTestVisible="False"
                                                   Visibility="{Binding Text, ElementName=FilterBox, Converter={StaticResource CollapsedWhen}}" />
                                        <TextBox x:Name="FilterBox" Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"
                                                 FontSize="13" Foreground="{StaticResource Black}" CaretBrush="{StaticResource Blue}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Button Style="{StaticResource Btn.Dark}" Height="36" Margin="0,0,0,12"
                                        Visibility="{Binding ShowAutoFill, Converter={StaticResource VisibleWhen}}" Click="OnAutoFill">
                                    <StackPanel Orientation="Horizontal">
                                        <local:PathIcon Data="{StaticResource Geo.Sparkle}" Width="13" Height="13" Filled="True" />
                                        <TextBlock Text="{Binding AutoFillText}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <local:PathIcon Data="{StaticResource Geo.Upload}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="Drag files from here onto a field" Margin="8,0,0,0" FontSize="12"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl Margin="8,4,8,8" ItemsSource="{Binding TreeRows}" ItemTemplate="{StaticResource TreeRowTemplate}" Focusable="False" />
                            </ScrollViewer>
                            <TextBlock Text="No matching files" Margin="20,8" VerticalAlignment="Top" Foreground="{StaticResource Subtle}"
                                       Visibility="{Binding NoTreeMatches, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ══ Sheet: the one white surface, 8 px from the right and bottom edge, radius 14, hairline + soft shadow.
                 Dropping files anywhere on it fills the matching fields. ═══════════════════════════════════════ -->
            <Grid Margin="0,0,8,8">
                <Border CornerRadius="14" Background="White">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0B0D12" Opacity="0.05" />
                    </Border.Effect>
                </Border>
                <Border Background="White" BorderBrush="{StaticResource SheetLine}" BorderThickness="1" CornerRadius="14">
                    <Grid Background="Transparent" AllowDrop="True" DragOver="OnPageDragOver" Drop="OnPageDrop">
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <StackPanel Margin="72,40,72,24" MaxWidth="960">

                                <!-- Heading: "Set up the run." 36 Bold, subtitle 14 Muted; right: Node | Python (34 high pill). -->
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Margin="24,0,0,0" VerticalAlignment="Bottom" Height="34" Padding="3"
                                            CornerRadius="17" Background="{StaticResource Track}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Segment}" Content="Node" GroupName="Mode" IsChecked="{Binding IsNode}" />
                                            <RadioButton Style="{StaticResource Segment}" Content="Python" GroupName="Mode" IsChecked="{Binding IsPython}" />
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="Set up the run." FontSize="36" FontWeight="Bold" />
                                        <TextBlock Text="{Binding SetupSubtitle}" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource Muted}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- Fields card: hairline, radius 16, 6 px padding, one row per field (FieldTemplate). -->
                                <Border Margin="0,20,0,0" Background="White" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                        CornerRadius="16" Padding="6">
                                    <ItemsControl x:Name="Fields" ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                                </Border>

                                <!-- "Get data from X" card, 16 below. Kept quiet: nothing filled or tinted.
                                       tile ... 34 × 34 in the 40 px glyph lane, radius 9, cloud icon: dashed + Subtle while empty;
                                                white with hairline + soft shadow, Ink icon and a green check once loaded
                                       text ... title 14 SemiBold; subtitle 13 Subtle, once loaded "160 records " + "for Gen X · from BAX"
                                                (Muted Medium) + " · 2 min ago"
                                       right .. empty: "For Gen X · from BAX" (13 Muted Medium) 16 px before a white "Import" (96 × 30);
                                                loaded: white "Refresh" (96 × 30) -->
                                <Border Margin="0,16,0,0" Background="White" BorderBrush="{StaticResource CardLine}" BorderThickness="1"
                                        CornerRadius="16" Padding="22,14">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="40" Height="40">
                                            <Rectangle Width="34" Height="34" RadiusX="9" RadiusY="9" Stroke="{StaticResource Dashed}" StrokeThickness="1.5"
                                                       StrokeDashArray="2 1.4" Visibility="{Binding XLoaded, Converter={StaticResource CollapsedWhen}}" />
                                            <Border Width="34" Height="34" CornerRadius="9" Background="White" BorderBrush="{StaticResource Hairline}"
                                                    BorderThickness="1" Visibility="{Binding XLoaded, Converter={StaticResource VisibleWhen}}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Color="#0B0D12" Opacity="0.06" />
                                                </Border.Effect>
                                            </Border>
                                            <local:PathIcon Data="{StaticResource Geo.Cloud}" Box="18" Width="18" Height="18" StrokeThickness="1.5">
                                                <local:PathIcon.Style>
                                                    <Style TargetType="local:PathIcon">
                                                        <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding XLoaded}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </local:PathIcon.Style>
                                            </local:PathIcon>
                                            <Grid Width="20" Height="20" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                  Visibility="{Binding XLoaded, Converter={StaticResource VisibleWhen}}">
                                                <Ellipse Fill="White" />
                                                <Ellipse Margin="2" Fill="{StaticResource Green}" />
                                                <local:PathIcon Data="{StaticResource Geo.Check8}" Box="8" Width="8" Height="8" StrokeThickness="1.5" Foreground="White" />
                                            </Grid>
                                        </Grid>

                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding XHint}" Margin="0,0,16,0" VerticalAlignment="Center" FontWeight="Medium"
                                                       Foreground="{StaticResource Muted}" Visibility="{Binding XLoaded, Converter={StaticResource CollapsedWhen}}" />
                                            <Grid>
                                                <Button Style="{StaticResource Btn.Outline}" Width="96" Height="30" Padding="0" Click="OnImport"
                                                        IsEnabled="{Binding CanImport}" ToolTip="{Binding ImportToolTip}" ToolTipService.ShowOnDisabled="True"
                                                        Visibility="{Binding XLoaded, Converter={StaticResource CollapsedWhen}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:PathIcon Data="{StaticResource Geo.Download}" Width="13" Height="13" StrokeThickness="1.4" />
                                                        <TextBlock Text="{Binding XButtonText}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Outline}" Width="96" Height="30" Padding="0" Click="OnImport"
                                                        IsEnabled="{Binding CanImport}" Visibility="{Binding XLoaded, Converter={StaticResource VisibleWhen}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:PathIcon Data="{StaticResource Geo.Refresh}" Width="13" Height="13" StrokeThickness="1.4" />
                                                        <TextBlock Text="{Binding XButtonText}" Margin="6,0,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding XTitle}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding XSubtitle}" Margin="0,2,0,0" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding XLoaded, Converter={StaticResource CollapsedWhen}}" />
                                            <TextBlock Margin="0,2,0,0" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding XLoaded, Converter={StaticResource VisibleWhen}}">
                                                <Run Text="{Binding XRecordsText, Mode=OneWay}" /><Run Text="{Binding XRouteText, Mode=OneWay}" FontWeight="Medium"
                                                     Foreground="{StaticResource Muted}" /><Run Text="{Binding XAgeText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tip (no project yet): pinned 40 px above the sheet's bottom edge, aligned with the cards. -->
                        <Border Grid.Row="1" Margin="72,0,72,40" MaxWidth="960" Visibility="{Binding HasProject, Converter={StaticResource CollapsedWhen}}">
                            <StackPanel Orientation="Horizontal">
                                <local:PathIcon Data="{StaticResource Geo.Info}" Foreground="{StaticResource Subtle}" StrokeThickness="1.2" />
                                <TextBlock Text="Tip: open the whole project folder in the sidebar and we'll fill matching fields for you."
                                           Margin="8,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
