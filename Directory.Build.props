<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>

    <Company>WpfUploadManager</Company>
    <Product>Upload Manager</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- Allows building the WPF project on Linux/macOS (e.g. in CI); the app itself only runs on Windows. -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
