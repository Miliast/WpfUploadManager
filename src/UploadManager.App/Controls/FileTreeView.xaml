<!--
    FileTreeView – modern file tree for WPF (part 1 of 2: design).
    Copy FileTreeView.xaml and FileTreeView.xaml.cs into any WPF project (.NET 8 or newer). No dependencies.

    Usage:
        xmlns:tree="clr-namespace:ModernFileTree"
        <tree:FileTreeView RootPath="C:\Data" ExtensionFilter=".pdf;.docx" FileActivated="OnFileActivated" />

    Appearance:
        Light (default)  light sidebar: #F2F2F2 background, hairline border, soft gray text
        Dark             dark sidebar: #121212 background, raised selection with top highlight and shadow
        Auto             transparent background, light/dark colors follow the inherited Foreground
                         (for embedding into panels of themed apps)
    All colors are defined below ("FileTree.Light.*" / "FileTree.Dark.*") and can be changed there.

    Font: "Inter" (free, https://rsms.me/inter) if installed, otherwise Segoe UI.

    License: MIT-0 – use, change and redistribute freely, no attribution required.
-->
<UserControl
    x:Class="ModernFileTree.FileTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:ModernFileTree"
    x:Name="Root"
    Background="{DynamicResource FileTree.Background}"
    BorderBrush="{DynamicResource FileTree.Border}"
    BorderThickness="0,0,1,0"
    FontFamily="Inter, Segoe UI"
    FontSize="14">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="FileTree.BoolToVisibility" />

        <!--
            Color palettes. The active palette is copied to the "FileTree.*" keys by the code-behind
            (see Appearance), so every element below uses DynamicResource "FileTree.<Name>".
        -->

        <!--  Light: measured from a light sidebar design (flat colors, no effects except the selection)  -->
        <SolidColorBrush x:Key="FileTree.Light.Background" Color="#F2F2F2" />
        <SolidColorBrush x:Key="FileTree.Light.Border" Color="#E5E5E5" />
        <SolidColorBrush x:Key="FileTree.Light.Text" Color="#636363" />
        <SolidColorBrush x:Key="FileTree.Light.TextSelected" Color="#1F1F1F" />
        <SolidColorBrush x:Key="FileTree.Light.Detail" Color="#A3A3A3" />
        <SolidColorBrush x:Key="FileTree.Light.Chevron" Color="#ABABAB" />
        <SolidColorBrush x:Key="FileTree.Light.Guide" Color="#E6E4E3" />
        <SolidColorBrush x:Key="FileTree.Light.Hover" Color="#0A000000" />
        <SolidColorBrush x:Key="FileTree.Light.Selected" Color="#FFFFFF" />
        <LinearGradientBrush x:Key="FileTree.Light.SelectedBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#12000000" />
            <GradientStop Offset="1" Color="#1F000000" />
        </LinearGradientBrush>
        <DropShadowEffect
            x:Key="FileTree.Light.SelectedShadow"
            BlurRadius="8"
            Direction="270"
            Opacity="0.06"
            ShadowDepth="1"
            Color="Black" />

        <!--  Dark: measured from a dark sidebar design (raised chip with lighter top edge and shadow)  -->
        <SolidColorBrush x:Key="FileTree.Dark.Background" Color="#121212" />
        <SolidColorBrush x:Key="FileTree.Dark.Border" Color="#1F1F1F" />
        <SolidColorBrush x:Key="FileTree.Dark.Text" Color="#A4A4A4" />
        <SolidColorBrush x:Key="FileTree.Dark.TextSelected" Color="#FFFFFF" />
        <SolidColorBrush x:Key="FileTree.Dark.Detail" Color="#6C6B70" />
        <SolidColorBrush x:Key="FileTree.Dark.Chevron" Color="#8A8B8D" />
        <SolidColorBrush x:Key="FileTree.Dark.Guide" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="FileTree.Dark.Hover" Color="#0DFFFFFF" />
        <SolidColorBrush x:Key="FileTree.Dark.Selected" Color="#19FFFFFF" />
        <LinearGradientBrush x:Key="FileTree.Dark.SelectedBorder" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#38FFFFFF" />
            <GradientStop Offset="1" Color="#12FFFFFF" />
        </LinearGradientBrush>
        <DropShadowEffect
            x:Key="FileTree.Dark.SelectedShadow"
            BlurRadius="6"
            Direction="270"
            Opacity="0.55"
            ShadowDepth="1"
            Color="Black" />

        <!--  Icons (vector, no icon font needed)  -->
        <Geometry x:Key="FileTree.FolderGeometry">M1.5,1 H6.2 C6.7,1 7.1,1.2 7.4,1.6 L8.5,3 H16.5 C17.3,3 18,3.7 18,4.5 V12.5 C18,13.3 17.3,14 16.5,14 H1.5 C0.7,14 0,13.3 0,12.5 V2.5 C0,1.7 0.7,1 1.5,1 Z</Geometry>
        <Geometry x:Key="FileTree.FileGeometry">M2,0 H8.5 L14,5.5 V16 C14,17.1 13.1,18 12,18 H2 C0.9,18 0,17.1 0,16 V2 C0,0.9 0.9,0 2,0 Z</Geometry>
        <Geometry x:Key="FileTree.FileFoldGeometry">M8.5,0 V4 C8.5,4.8 9.2,5.5 10,5.5 H14 Z</Geometry>

        <!--  Chevron that rotates smoothly from ">" to "v"  -->
        <Style x:Key="FileTree.ChevronStyle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path
                                x:Name="Chevron"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 0,0 L 4,4 L 0,8"
                                RenderTransformOrigin="0.5,0.5"
                                Stroke="{DynamicResource FileTree.Chevron}"
                                StrokeEndLineCap="Round"
                                StrokeLineJoin="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.4">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Chevron"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                To="90"
                                                Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Chevron"
                                                Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                To="0"
                                                Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chevron" Property="Stroke" Value="{DynamicResource FileTree.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Tree container: transparent, no border, pixel scrolling, virtualized  -->
        <Style x:Key="FileTree.TreeViewStyle" TargetType="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2,8,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeView">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                            <ScrollViewer
                                x:Name="_tv_scrollviewer_"
                                Padding="{TemplateBinding Padding}"
                                CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                Focusable="False"
                                HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Row: [hover layer | selection layer | chevron + content] above [children + guide line]  -->
        <Style x:Key="FileTree.ItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsItemsHost="True" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <StackPanel>
                            <Grid
                                x:Name="Row"
                                MinHeight="32"
                                Margin="0,1"
                                Background="Transparent">
                                <Border
                                    x:Name="HoverLayer"
                                    Background="{DynamicResource FileTree.Hover}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <Border
                                    x:Name="SelectionLayer"
                                    Background="{DynamicResource FileTree.Selected}"
                                    BorderBrush="{DynamicResource FileTree.SelectedBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Effect="{DynamicResource FileTree.SelectedShadow}"
                                    Opacity="0" />

                                <Grid Margin="{Binding Indent}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton
                                        x:Name="Expander"
                                        ClickMode="Press"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Style="{StaticResource FileTree.ChevronStyle}" />
                                    <ContentPresenter
                                        x:Name="PART_Header"
                                        Grid.Column="1"
                                        Margin="2,0,10,0"
                                        VerticalAlignment="Center"
                                        ContentSource="Header" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="ChildrenHost">
                                <Rectangle
                                    Width="1"
                                    Margin="{Binding GuideIndent}"
                                    HorizontalAlignment="Left"
                                    Fill="{DynamicResource FileTree.Guide}"
                                    SnapsToDevicePixels="True" />
                                <ItemsPresenter x:Name="ItemsHost" />
                            </Grid>
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ChildrenHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SelectionLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="SelectionLayer"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <TreeView
            x:Name="Tree"
            AutomationProperties.Name="File tree"
            ItemContainerStyle="{StaticResource FileTree.ItemStyle}"
            ItemsSource="{Binding Items, ElementName=Root}"
            KeyDown="OnTreeKeyDown"
            MouseDoubleClick="OnTreeMouseDoubleClick"
            PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
            PreviewMouseMove="OnTreePreviewMouseMove"
            SelectedItemChanged="OnTreeSelectedItemChanged"
            Style="{StaticResource FileTree.TreeViewStyle}">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type local:FileTreeNode}" ItemsSource="{Binding Children}">
                    <Grid ToolTip="{Binding ToolTip}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Icon: colored folder or colored document  -->
                        <Grid
                            Width="18"
                            Height="18"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                            <Viewbox
                                Width="17"
                                Height="14"
                                Visibility="{Binding IsDirectory, Converter={StaticResource FileTree.BoolToVisibility}}">
                                <Canvas Width="18" Height="15">
                                    <Path Data="{StaticResource FileTree.FolderGeometry}" Fill="{Binding IconBrush}" />
                                </Canvas>
                            </Viewbox>
                            <Viewbox
                                Width="13"
                                Height="17"
                                Visibility="{Binding IsFile, Converter={StaticResource FileTree.BoolToVisibility}}">
                                <Canvas Width="14" Height="18">
                                    <Path Data="{StaticResource FileTree.FileGeometry}" Fill="{Binding IconBrush}" />
                                    <Path Data="{StaticResource FileTree.FileFoldGeometry}" Fill="#59FFFFFF" />
                                </Canvas>
                            </Viewbox>
                        </Grid>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource FileTree.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource FileTree.TextSelected}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource FileTree.Detail}" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="#FFE5534B"
                                Text="{Binding ErrorMessage}"
                                Visibility="{Binding HasError, Converter={StaticResource FileTree.BoolToVisibility}}" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource FileTree.Detail}"
                                Text="{Binding DetailText}" />
                        </StackPanel>
                    </Grid>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!--  Shown when the folder is empty or cannot be read  -->
        <TextBlock
            Margin="24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{DynamicResource FileTree.Detail}"
            Text="{Binding Message, ElementName=Root}"
            TextAlignment="Center"
            TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Message, ElementName=Root}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
