<UserControl
    x:Class="UploadManager.App.Views.FileExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tree="clr-namespace:ModernFileTree"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:UploadManager.Core.ViewModels;assembly=UploadManager.Core"
    d:DataContext="{d:DesignInstance Type=vm:FileExplorerViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="360"
    mc:Ignorable="d">

    <Border Padding="0" Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header: section label, opened folder, actions  -->
            <Grid Grid.Row="0" Margin="16,14,10,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="EXPLORER" />

                    <Grid Margin="0,8,0,0" Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Filled="True"
                            FontSize="18"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Symbol="Folder20" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding RootName}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding RootPath}" />
                    </Grid>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    Orientation="Horizontal">
                    <ui:Button
                        Padding="6"
                        AutomationProperties.Name="Ordner öffnen"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Command="{Binding OpenFolderCommand}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        ToolTip="Ordner öffnen (Strg+O)" />
                    <ui:Button
                        Margin="2,0,0,0"
                        Padding="6"
                        AutomationProperties.Name="Aktualisieren"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Command="{Binding RefreshCommand}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        ToolTip="Aktualisieren (F5)" />
                </StackPanel>
            </Grid>

            <!--  Path and filter  -->
            <StackPanel
                Grid.Row="1"
                Margin="16,2,16,6"
                Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock
                    Margin="28,0,0,8"
                    Style="{StaticResource CaptionTextStyle}"
                    Text="{Binding RootPath}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="NoWrap"
                    ToolTip="{Binding RootPath}" />
                <ui:ToggleSwitch
                    Content="Nur passende Dateitypen"
                    IsChecked="{Binding ShowOnlySupportedFiles}"
                    ToolTip="Blendet Dateien aus, die in kein Upload-Feld passen" />
            </StackPanel>

            <Rectangle
                Grid.Row="2"
                Height="1"
                Margin="12,4,12,6"
                Fill="{DynamicResource DividerStrokeColorDefaultBrush}"
                Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Tree: reusable two-file control (Controls/FileTreeView.xaml + .xaml.cs)  -->
            <tree:FileTreeView
                x:Name="FileTree"
                Grid.Row="3"
                Appearance="Auto"
                AutomationProperties.Name="Dateibaum"
                EmptyText="Keine passenden Dateien in diesem Ordner. Schalte den Filter aus oder wähle einen anderen Ordner."
                FileActivatedCommand="{Binding ActivateFileCommand}"
                FileFilter="{Binding FileFilter}"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                LoadingText="Wird geladen …"
                RootPath="{Binding RootPath}"
                SelectedPath="{Binding SelectedPath}"
                Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Empty state: no folder opened yet  -->
            <StackPanel
                Grid.Row="0"
                Grid.RowSpan="4"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasRoot, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    Filled="True"
                    FontSize="48"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="FolderOpen24" />
                <TextBlock
                    Margin="0,12,0,4"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="Kein Ordner geöffnet" />
                <TextBlock
                    MaxWidth="260"
                    Style="{StaticResource BodySecondaryTextStyle}"
                    Text="Öffne einen Ordner, um Dateien per Drag &amp; Drop oder Doppelklick den Upload-Feldern zuzuweisen."
                    TextAlignment="Center" />
                <ui:Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding OpenFolderCommand}"
                    Content="Ordner öffnen"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>

            <!--  Hint  -->
            <Border
                Grid.Row="4"
                Padding="16,10"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Tipp: Doppelklick oder Enter weist eine Datei automatisch dem passenden Feld zu. Dateien lassen sich auch direkt auf ein Feld ziehen." />
            </Border>
        </Grid>
    </Border>
</UserControl>
