<UserControl
    x:Class="UploadManager.App.Views.FileExplorerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:UploadManager.Core.ViewModels;assembly=UploadManager.Core"
    d:DataContext="{d:DesignInstance Type=vm:FileExplorerViewModel}"
    d:DesignHeight="600"
    d:DesignWidth="360"
    mc:Ignorable="d">

    <Border Padding="0" Style="{StaticResource PanelBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Grid.Row="0" Margin="16,12,8,4">
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <ui:SymbolIcon
                        Margin="0,0,8,0"
                        FontSize="20"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="Folder24" />
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="Explorer" />
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <ui:Button
                        Padding="6"
                        AutomationProperties.Name="Ordner öffnen"
                        Appearance="Transparent"
                        Command="{Binding OpenFolderCommand}"
                        Icon="{ui:SymbolIcon FolderOpen24}"
                        ToolTip="Ordner öffnen (Strg+O)" />
                    <ui:Button
                        Margin="4,0,0,0"
                        Padding="6"
                        AutomationProperties.Name="Aktualisieren"
                        Appearance="Transparent"
                        Command="{Binding RefreshCommand}"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        ToolTip="Aktualisieren (F5)" />
                </StackPanel>
            </Grid>

            <!--  Current folder  -->
            <TextBlock
                Grid.Row="1"
                Margin="16,0,16,8"
                Style="{StaticResource CaptionTextStyle}"
                Text="{Binding RootPath}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap"
                ToolTip="{Binding RootPath}"
                Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Filter  -->
            <ui:ToggleSwitch
                Grid.Row="2"
                Margin="16,0,16,8"
                Content="Nur passende Dateitypen"
                IsChecked="{Binding ShowOnlySupportedFiles}"
                ToolTip="Blendet Dateien aus, die in kein Upload-Feld passen"
                Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <!--  Tree  -->
            <TreeView
                x:Name="FileTree"
                Grid.Row="3"
                Margin="4,0,4,4"
                AutomationProperties.Name="Dateibaum"
                ItemsSource="{Binding RootNodes}"
                KeyDown="OnTreeKeyDown"
                MouseDoubleClick="OnTreeMouseDoubleClick"
                PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                PreviewMouseMove="OnTreePreviewMouseMove"
                SelectedItemChanged="OnTreeSelectedItemChanged"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                Visibility="{Binding HasRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource DefaultTreeViewItemStyle}" TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type vm:FileSystemNodeViewModel}" ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding FullPath}">
                            <ui:SymbolIcon
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="16">
                                <ui:SymbolIcon.Style>
                                    <Style TargetType="ui:SymbolIcon">
                                        <Setter Property="Symbol" Value="Document24" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                <Setter Property="Symbol" Value="Folder24" />
                                                <Setter Property="Filled" Value="True" />
                                                <Setter Property="Foreground" Value="#FFE8B04B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Symbol" Value="FolderOpen24" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ui:SymbolIcon.Style>
                            </ui:SymbolIcon>

                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource CaptionTextStyle}"
                                Text="{Binding SizeText}" />

                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource ErrorTextStyle}"
                                Text="{Binding ErrorMessage}"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!--  Empty state  -->
            <StackPanel
                Grid.Row="3"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding HasRoot, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="48"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="FolderOpen24" />
                <TextBlock
                    Margin="0,12,0,4"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="Kein Ordner geöffnet" />
                <TextBlock
                    MaxWidth="260"
                    Style="{StaticResource BodySecondaryTextStyle}"
                    Text="Öffne einen Ordner, um Dateien per Drag &amp; Drop oder Doppelklick den Upload-Feldern zuzuweisen."
                    TextAlignment="Center" />
                <ui:Button
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding OpenFolderCommand}"
                    Content="Ordner öffnen"
                    Icon="{ui:SymbolIcon FolderOpen24}" />
            </StackPanel>

            <!--  Hint  -->
            <Border
                Grid.Row="4"
                Padding="16,10"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Tipp: Doppelklick oder Enter weist eine Datei automatisch dem passenden Feld zu. Dateien lassen sich auch direkt auf ein Feld ziehen." />
            </Border>
        </Grid>
    </Border>
</UserControl>
