<UserControl
    x:Class="UploadManager.App.Views.UploadSlotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:UploadManager.App.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:UploadManager.Core.ViewModels;assembly=UploadManager.Core"
    d:DataContext="{d:DesignInstance Type=vm:UploadSlotViewModel}"
    d:DesignHeight="300"
    d:DesignWidth="420"
    AutomationProperties.Name="{Binding Title}"
    mc:Ignorable="d">

    <Border
        Padding="16"
        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Ready}">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Completed}">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Invalid}">
                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!--  Header: number, title, required/optional tag, state icon  -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="28"
                    Height="28"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                    CornerRadius="14">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                        Text="{Binding Number}" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="10,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource SectionTitleTextStyle}"
                    Text="{Binding Title}"
                    ToolTip="{Binding Title}" />

                <Border Grid.Column="2" Style="{StaticResource TagBorderStyle}">
                    <TextBlock FontSize="11" Text="{Binding RequirementText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRequired}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <ui:SymbolIcon
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Filled="True"
                    FontSize="22"
                    ToolTip="{Binding StatusText}">
                    <ui:SymbolIcon.Style>
                        <Style TargetType="ui:SymbolIcon">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Ready}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Symbol" Value="CheckmarkCircle24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Completed}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Symbol" Value="CloudArrowUp24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Invalid}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Setter Property="Symbol" Value="ErrorCircle24" />
                                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:SymbolIcon.Style>
                </ui:SymbolIcon>
            </Grid>

            <!--  Description and rules  -->
            <TextBlock
                Grid.Row="1"
                Margin="0,10,0,0"
                Style="{StaticResource BodySecondaryTextStyle}"
                Text="{Binding Description}" />

            <TextBlock
                Grid.Row="2"
                Margin="0,4,0,0"
                Style="{StaticResource CaptionTextStyle}"
                Text="{Binding ConstraintsText}" />

            <!--  Drop zone  -->
            <Grid
                x:Name="DropZone"
                Grid.Row="3"
                Margin="0,12,0,0"
                behaviors:FileDrop.Command="{Binding DropFilesCommand}"
                Background="Transparent">

                <Rectangle
                    RadiusX="8"
                    RadiusY="8"
                    StrokeDashArray="4 3"
                    StrokeThickness="1.5">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="Stroke" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            <Setter Property="Fill" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Ready}">
                                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Completed}">
                                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="{x:Static vm:UploadSlotState.Invalid}">
                                    <Setter Property="Stroke" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                </DataTrigger>
                                <!--  Last trigger wins: drag feedback overrides the state colors  -->
                                <DataTrigger Binding="{Binding Path=(behaviors:FileDrop.IsDragOver), ElementName=DropZone}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!--  Empty state  -->
                <StackPanel
                    Margin="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ui:SymbolIcon
                        HorizontalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Symbol="ArrowUpload24" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="Datei hierher ziehen" />
                    <TextBlock
                        Margin="0,2,0,10"
                        HorizontalAlignment="Center"
                        Style="{StaticResource CaptionTextStyle}"
                        Text="oder" />
                    <WrapPanel HorizontalAlignment="Center">
                        <ui:Button
                            Margin="4"
                            Command="{Binding BrowseCommand}"
                            Content="Durchsuchen …"
                            Icon="{ui:SymbolIcon FolderOpen24}" />
                        <ui:Button
                            Margin="4"
                            Command="{Binding DataContext.AssignSelectedFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Content="Markierte übernehmen"
                            Icon="{ui:SymbolIcon DocumentArrowRight24}"
                            ToolTip="Die links im Explorer markierte Datei übernehmen" />
                    </WrapPanel>
                </StackPanel>

                <!--  Assigned file  -->
                <Grid
                    Margin="16"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ui:SymbolIcon
                        Grid.RowSpan="2"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        FontSize="32"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Document24" />

                    <TextBlock
                        Grid.Column="1"
                        FontWeight="SemiBold"
                        Text="{Binding FileName}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FilePath}" />

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2,0,0"
                        Style="{StaticResource CaptionTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">
                        <Run Text="{Binding FileSizeText, Mode=OneWay}" />
                        <Run Text=" · " />
                        <Run Text="{Binding StatusText, Mode=OneWay}" />
                    </TextBlock>

                    <StackPanel
                        Grid.RowSpan="2"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ui:Button
                            Padding="6"
                            AutomationProperties.Name="Andere Datei wählen"
                            Appearance="Transparent"
                            Command="{Binding BrowseCommand}"
                            Icon="{ui:SymbolIcon ArrowSwap24}"
                            ToolTip="Andere Datei wählen" />
                        <ui:Button
                            Margin="4,0,0,0"
                            Padding="6"
                            AutomationProperties.Name="Datei entfernen"
                            Appearance="Transparent"
                            Command="{Binding ClearCommand}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            ToolTip="Datei entfernen" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,10,0,0"
                        Style="{StaticResource ErrorTextStyle}"
                        Text="{Binding ErrorMessage}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <ProgressBar
                        Grid.Row="2"
                        Grid.ColumnSpan="3"
                        Margin="0,12,0,0"
                        Maximum="1"
                        Minimum="0"
                        Visibility="{Binding IsUploading, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Value="{Binding Progress, Mode=OneWay}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
