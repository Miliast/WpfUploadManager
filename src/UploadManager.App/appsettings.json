{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Upload": {
    "UseSimulation": true,
    "Endpoint": "https://localhost:5001/api/uploads",
    "Timeout": "00:10:00",
    "Slots": [
      {
        "Key": "document",
        "Title": "Hauptdokument",
        "Description": "Das zentrale Dokument, z. B. Antrag, Bericht oder Vertrag.",
        "AllowedExtensions": [ ".pdf", ".docx" ],
        "MaxSizeMb": 25,
        "IsRequired": true
      },
      {
        "Key": "data",
        "Title": "Datentabelle",
        "Description": "Die zugehörigen Daten als Excel- oder CSV-Datei.",
        "AllowedExtensions": [ ".xlsx", ".xls", ".csv" ],
        "MaxSizeMb": 50,
        "IsRequired": true
      },
      {
        "Key": "config",
        "Title": "Konfiguration",
        "Description": "Konfigurations- bzw. Metadatendatei.",
        "AllowedExtensions": [ ".json", ".xml", ".yaml", ".yml" ],
        "MaxSizeMb": 5,
        "IsRequired": true
      },
      {
        "Key": "attachment",
        "Title": "Anhang",
        "Description": "Optionaler Anhang, z. B. Foto, Scan oder Archiv.",
        "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".zip" ],
        "MaxSizeMb": 100,
        "IsRequired": false
      }
    ]
  }
}
