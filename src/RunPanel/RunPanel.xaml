<!--
    The two boxes of a test run: the test card (node tabs or one summary line, state filters, test list with the live
    "Running" row) and the log panel below it. Everything it needs is in here – colours, icons, styles, converters –
    so the control works in any app without App.xaml. Data comes from RunPanel.Session (see RunPanel.xaml.cs).
-->
<UserControl x:Class="TestRunUi.RunPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:TestRunUi"
             mc:Ignorable="d"
             Background="#F6F6F7"
             d:DesignWidth="980" d:DesignHeight="600">

    <UserControl.Resources>

        <!-- ══ Colours ═══════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Blue" Color="#1F4BFF" />
        <SolidColorBrush x:Key="BlueSoft" Color="#F3F6FF" />
        <SolidColorBrush x:Key="BlueChip" Color="#EEF2FF" />
        <SolidColorBrush x:Key="BlueRing" Color="#C9D4FF" />

        <SolidColorBrush x:Key="Ink" Color="#0B0D12" />
        <SolidColorBrush x:Key="Black" Color="#000000" />
        <SolidColorBrush x:Key="Body" Color="#2A2F3A" />
        <SolidColorBrush x:Key="Muted" Color="#5B6270" />
        <SolidColorBrush x:Key="Subtle" Color="#8A909C" />
        <SolidColorBrush x:Key="Faint" Color="#A0A6B1" />
        <SolidColorBrush x:Key="Faintest" Color="#B4B9C3" />
        <SolidColorBrush x:Key="Dot" Color="#C4C9D2" />
        <SolidColorBrush x:Key="Skeleton" Color="#D5D9E0" />
        <SolidColorBrush x:Key="Line" Color="#E6E8EC" />
        <SolidColorBrush x:Key="LineSoft" Color="#F0F1F3" />
        <SolidColorBrush x:Key="Chip" Color="#F2F3F5" />
        <SolidColorBrush x:Key="Track" Color="#ECEDEF" />
        <SolidColorBrush x:Key="TrackDark" Color="#DADDE2" />
        <SolidColorBrush x:Key="White" Color="#FFFFFF" />

        <SolidColorBrush x:Key="Green" Color="#12A150" />
        <SolidColorBrush x:Key="GreenSoft" Color="#E4F5EB" />
        <SolidColorBrush x:Key="Red" Color="#E5383B" />
        <SolidColorBrush x:Key="RedText" Color="#C2262A" />
        <SolidColorBrush x:Key="RedSoft" Color="#FDEEEE" />
        <SolidColorBrush x:Key="RedLine" Color="#F3CACB" />
        <SolidColorBrush x:Key="Amber" Color="#E89B0C" />
        <SolidColorBrush x:Key="AmberText" Color="#9A6700" />
        <SolidColorBrush x:Key="AmberSoft" Color="#FDF3E1" />
        <SolidColorBrush x:Key="WarnRow" Color="#FFF7E8" />
        <SolidColorBrush x:Key="WarnTag" Color="#B87A00" />
        <SolidColorBrush x:Key="WarnText" Color="#7A5300" />

        <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <!-- ══ Converters ════════════════════════════════════════════════════ -->
        <local:VisibleWhen x:Key="VisibleWhen" />
        <local:VisibleWhen x:Key="CollapsedWhen" Invert="True" />
        <local:StarConverter x:Key="Star" />
        <local:PieConverter x:Key="Pie" />
        <local:EqualsConverter x:Key="Equals" />

        <!-- ══ Icons (SVG path data; Box = viewBox size) ═════════════════════ -->
        <Geometry x:Key="Geo.Terminal">M3.5,2.5 H10.5 A2,2 0 0 1 12.5,4.5 V9.5 A2,2 0 0 1 10.5,11.5 H3.5 A2,2 0 0 1 1.5,9.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M4,6 L5.8,7.5 L4,9 M7.5,9 H10</Geometry>
        <Geometry x:Key="Geo.Copy">M6,4.5 H10 A1.5,1.5 0 0 1 11.5,6 V10 A1.5,1.5 0 0 1 10,11.5 H6 A1.5,1.5 0 0 1 4.5,10 V6 A1.5,1.5 0 0 1 6,4.5 Z M9.5,4.5 V3 A0.5,0.5 0 0 0 9,2.5 H3 A0.5,0.5 0 0 0 2.5,3 V9 A0.5,0.5 0 0 0 3,9.5 H4.5</Geometry>
        <Geometry x:Key="Geo.Close">M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5</Geometry>
        <Geometry x:Key="Geo.Check8">M1.5,4.2 L3.2,5.8 L6.5,2.4</Geometry>
        <Geometry x:Key="Geo.Cross8">M2,2 L6,6 M6,2 L2,6</Geometry>

        <!-- ══ Text ══════════════════════════════════════════════════════════ -->
        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ══ Cards: white surface with hairline + soft shadow. The shadow sits on its own layer behind the card,
                so text on the card keeps ClearType. ═══════════════════════ -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#140B0D12" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#0B0D12" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardShadowUp" TargetType="Border" BasedOn="{StaticResource CardShadow}">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="90" Color="#0B0D12" Opacity="0.1" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Buttons: one flat template, each variant only sets colours, radius (local:Look.CornerRadius) and hover ══ -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Black}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding (local:Look.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Red outline "Stop Payments". -->
        <Style x:Key="Btn.DangerOutline" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource RedText}" />
            <Setter Property="BorderBrush" Value="{StaticResource RedLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="local:Look.CornerRadius" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon buttons in the log bar. -->
        <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="local:Look.CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Chip}" />
                    <Setter Property="Foreground" Value="{StaticResource Black}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Grey text link ("Show 19 earlier tests"). -->
        <Style x:Key="Btn.LinkMuted" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Black}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ Blue spinner of the running test ══════════════════════════════ -->
        <ControlTemplate x:Key="Spinner" TargetType="Control">
            <Grid x:Name="Root" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform />
                </Grid.RenderTransform>
                <Ellipse Stroke="{StaticResource BlueRing}" StrokeThickness="2" />
                <Path Data="M8,1 A7,7 0 0 1 15,8" Stroke="{StaticResource Blue}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══ Slim scroll bars (apply inside this control only) ═════════════ -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{StaticResource Skeleton}" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Faintest}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Ink}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter TextElement.Foreground="White" TextElement.FontSize="12"
                                              TextElement.FontFamily="{StaticResource Sans}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Node status icon (14 px): progress ring, or green check when all tests ran; red/amber dot on problems.
                Ring colour = the ContentControl's Foreground, ring of the dot = its Tag (the background behind it). ══ -->
        <DataTemplate x:Key="NodeIcon" DataType="{x:Type local:RunNode}">
            <Grid Width="14" Height="14">
                <Grid x:Name="Ring">
                    <Ellipse Margin="0.25" StrokeThickness="1.5"
                             Stroke="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                    <Path Data="{Binding Fraction, Converter={StaticResource Pie}}"
                          Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
                </Grid>
                <Grid x:Name="Check" Visibility="Collapsed">
                    <Ellipse Fill="{StaticResource Green}" />
                    <local:PathIcon Data="{StaticResource Geo.Check8}" Box="8" Width="8" Height="8" StrokeThickness="1.6" Foreground="White" />
                </Grid>
                <Ellipse x:Name="Dot" Width="10" Height="10" Margin="0,-4.5,-4.5,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                         StrokeThickness="1.5" Visibility="Collapsed"
                         Stroke="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasAborted}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Red}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── Segmented progress bar: passed | failed | aborted | rest. Track colour = the ContentControl's Tag. -->
        <DataTemplate x:Key="ProgressBar" DataType="{x:Type local:RunNode}">
            <Border CornerRadius="1.5" local:Look.ClipToCorners="True"
                    Background="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding Passed, Converter={StaticResource Star}}" />
                        <ColumnDefinition Width="{Binding Failed, Converter={StaticResource Star}}" />
                        <ColumnDefinition Width="{Binding Aborted, Converter={StaticResource Star}}" />
                        <ColumnDefinition Width="{Binding Rest, Converter={StaticResource Star}}" />
                    </Grid.ColumnDefinitions>
                    <Rectangle Fill="{StaticResource Green}" />
                    <Rectangle Grid.Column="1" Fill="{StaticResource Red}" />
                    <Rectangle Grid.Column="2" Fill="{StaticResource Amber}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Node tabs (multi mode) ───────────────────────────────────────── -->
        <Style x:Key="NodeTab" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Margin="2,0" Padding="14,9" CornerRadius="10" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F6F7F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NodeTabTemplate" DataType="{x:Type local:RunNode}">
            <StackPanel>
                <DockPanel>
                    <ContentControl x:Name="Icon" DockPanel.Dock="Left" Content="{Binding}" ContentTemplate="{StaticResource NodeIcon}"
                                    Focusable="False" Foreground="{StaticResource Faintest}" Tag="{StaticResource White}" />
                    <TextBlock x:Name="Progress" DockPanel.Dock="Right" Text="{Binding ProgressText}" Margin="8,0,0,0" FontSize="12"
                               Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Aborted}" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource AmberText}" VerticalAlignment="Center"
                               Visibility="{Binding HasAborted, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Failed}" Margin="8,0,0,0" FontSize="11" FontWeight="SemiBold"
                               Foreground="{StaticResource RedText}" VerticalAlignment="Center"
                               Visibility="{Binding HasFailed, Converter={StaticResource VisibleWhen}}" />
                    <TextBlock x:Name="Name" Text="{Binding Name}" Margin="8,0,0,0" FontWeight="Medium" Foreground="{StaticResource Muted}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <ContentControl x:Name="Bar" Content="{Binding}" ContentTemplate="{StaticResource ProgressBar}" Height="2" Margin="0,8,0,0"
                                Focusable="False" Tag="{StaticResource Track}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Icon" Property="Tag" Value="{StaticResource LineSoft}" />
                    <Setter TargetName="Name" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Name" Property="Foreground" Value="{StaticResource Black}" />
                    <Setter TargetName="Progress" Property="Foreground" Value="{StaticResource Subtle}" />
                    <Setter TargetName="Bar" Property="Tag" Value="{StaticResource TrackDark}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── State filters: All / Passed / Failed / Aborted ──────────────── -->
        <Style x:Key="Filter" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="12,0" CornerRadius="8" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Chip}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource LineSoft}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True">
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{StaticResource Black}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Count next to a filter; colour comes in via Tag, 0 always reads faint. -->
        <Style x:Key="FilterCount" TargetType="TextBlock">
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ── One finished test ───────────────────────────────────────────── -->
        <DataTemplate x:Key="TestTemplate" DataType="{x:Type local:RunTest}">
            <DockPanel Height="42" Margin="12,0">
                <TextBlock DockPanel.Dock="Left" Width="28" Text="{Binding No}" Style="{StaticResource MonoText}" FontSize="11"
                           Foreground="{StaticResource Subtle}" />
                <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="14,0,0,0">
                    <Border x:Name="StatusBg" CornerRadius="8" Background="{StaticResource GreenSoft}" />
                    <local:PathIcon x:Name="Check" Data="{StaticResource Geo.Check8}" Box="8" Width="8" Height="8" StrokeThickness="1.5"
                                    Foreground="{StaticResource Green}" />
                    <local:PathIcon x:Name="Cross" Data="{StaticResource Geo.Cross8}" Box="8" Width="8" Height="8" StrokeThickness="1.5"
                                    Foreground="{StaticResource Red}" Visibility="Collapsed" />
                    <Border x:Name="Dash" Width="7" Height="1.5" CornerRadius="1" Background="{StaticResource Amber}" Visibility="Collapsed" />
                </Grid>
                <TextBlock DockPanel.Dock="Right" Width="48" Margin="14,0,0,0" Text="{Binding TimeText}" TextAlignment="Right"
                           Style="{StaticResource MonoText}" Foreground="{StaticResource Subtle}" />
                <TextBlock x:Name="Note" DockPanel.Dock="Right" Margin="14,0,0,0" Text="{Binding Note}" Style="{StaticResource MonoText}"
                           Visibility="{Binding Note, Converter={StaticResource VisibleWhen}}" />
                <TextBlock Text="{Binding Name}" Margin="14,0,0,0" FontSize="14" Foreground="{StaticResource Body}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Failed">
                    <Setter TargetName="StatusBg" Property="Background" Value="{StaticResource RedSoft}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Cross" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Note" Property="Foreground" Value="{StaticResource RedText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Aborted">
                    <Setter TargetName="StatusBg" Property="Background" Value="{StaticResource AmberSoft}" />
                    <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Note" Property="Foreground" Value="{StaticResource AmberText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── Log panel ────────────────────────────────────────────────────── -->
        <Style x:Key="LogTab" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="Shadow" CornerRadius="7" Background="White" Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Color="#0B0D12" Opacity="0.1" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Bd" Height="24" Padding="10,0" CornerRadius="7" Background="Transparent">
                                <ContentPresenter x:Name="Text" VerticalAlignment="Center" TextElement.FontSize="12"
                                                  TextElement.FontWeight="Medium" TextElement.Foreground="{StaticResource Muted}" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource Black}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Shadow" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Bd" Property="Background" Value="White" />
                                <Setter TargetName="Text" Property="TextElement.FontWeight" Value="SemiBold" />
                                <Setter TargetName="Text" Property="TextElement.Foreground" Value="{StaticResource Black}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="LogTemplate" DataType="{x:Type local:RunLine}">
            <Border x:Name="Bd" CornerRadius="6" Padding="12,3" TextElement.FontFamily="{StaticResource Mono}" TextElement.FontSize="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Time}" Foreground="{StaticResource Faint}" />
                    <TextBlock x:Name="KindTag" DockPanel.Dock="Left" Width="40" Margin="14,0,0,0" Text="{Binding Tag}" Foreground="{StaticResource Faint}" />
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                        <TextBlock Text="{Binding NodePrefix}" Foreground="{StaticResource Subtle}"
                                   Visibility="{Binding DataContext.IsAllLogs, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource VisibleWhen}}" />
                        <TextBlock x:Name="Message" Foreground="{StaticResource Body}">
                            <Run Text="{Binding Text, Mode=OneWay}" /><Run Text="{Binding DimText, Mode=OneWay}" Foreground="{StaticResource Subtle}" />
                        </TextBlock>
                        <Border Width="7" Height="14" Margin="6,0,0,0" CornerRadius="1" Background="{StaticResource Blue}" VerticalAlignment="Center"
                                Visibility="{Binding ShowCursor, Converter={StaticResource VisibleWhen}}">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.6"
                                                             AutoReverse="True" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Pass">
                    <Setter TargetName="KindTag" Property="Foreground" Value="{StaticResource Green}" />
                    <Setter TargetName="KindTag" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Run">
                    <Setter TargetName="KindTag" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="KindTag" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Fail">
                    <Setter TargetName="KindTag" Property="Foreground" Value="{StaticResource RedText}" />
                    <Setter TargetName="KindTag" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource RedSoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn">
                    <Setter TargetName="KindTag" Property="Foreground" Value="{StaticResource WarnTag}" />
                    <Setter TargetName="KindTag" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource WarnRow}" />
                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource WarnText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid TextElement.FontFamily="{StaticResource Sans}" TextElement.FontSize="13" TextElement.Foreground="{StaticResource Ink}">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ Box 1: the test card ═════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Margin" Value="24" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding LogsOpen}" Value="True">
                            <Setter Property="Margin" Value="24,24,24,10" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border Style="{StaticResource CardShadow}" CornerRadius="20" />
            <Border Style="{StaticResource Card}" CornerRadius="20" local:Look.ClipToCorners="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!-- Multi: one tab per node -->
                    <Border BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsMulti, Converter={StaticResource VisibleWhen}}">
                        <ListBox Margin="6,8" ItemsSource="{Binding Nodes}" SelectedItem="{Binding SelectedNode}"
                                 ItemContainerStyle="{StaticResource NodeTab}" ItemTemplate="{StaticResource NodeTabTemplate}"
                                 FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ItemsPresenter />
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                    </Border>

                    <!-- Single: summary line + bar -->
                    <Border Padding="20,16,20,14" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsMulti, Converter={StaticResource CollapsedWhen}}">
                        <StackPanel>
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Left" Width="16" Height="16">
                                    <ContentControl Content="{Binding SelectedNode}" ContentTemplate="{StaticResource NodeIcon}" Focusable="False"
                                                    Foreground="{StaticResource Blue}" Tag="{StaticResource White}" />
                                </Viewbox>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding HeaderRightText}" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding SelectedNode.Name}" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedNode.Runtime}" Margin="10,0,0,0" Foreground="{StaticResource Subtle}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedNode.Runtime, Converter={StaticResource VisibleWhen}}" />
                                    <Ellipse Width="3" Height="3" Margin="10,0,0,0" Fill="{StaticResource Dot}" />
                                    <TextBlock Margin="10,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center">
                                        <Run Text="{Binding HeaderCount, Mode=OneWay}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><Run Text="{Binding HeaderCountRest, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding SelectedNode.Failed, StringFormat={}{0} failed}" Margin="14,0,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource RedText}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedNode.HasFailed, Converter={StaticResource VisibleWhen}}" />
                                    <TextBlock Text="{Binding SelectedNode.Aborted, StringFormat={}{0} aborted}" Margin="10,0,0,0" FontWeight="SemiBold"
                                               Foreground="{StaticResource AmberText}" VerticalAlignment="Center"
                                               Visibility="{Binding SelectedNode.HasAborted, Converter={StaticResource VisibleWhen}}" />
                                </StackPanel>
                            </DockPanel>
                            <ContentControl Content="{Binding SelectedNode}" ContentTemplate="{StaticResource ProgressBar}" Height="3" Margin="0,12,0,0"
                                            Focusable="False" Tag="{StaticResource Track}" />
                        </StackPanel>
                    </Border>

                    <!-- Filters + queue info -->
                    <Border Grid.Row="1" Padding="16,14" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{Binding QueueText}" FontSize="12" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                                <Button Style="{StaticResource Btn.DangerOutline}" Height="28" Margin="12,0,0,0" Click="OnStopSelected"
                                        Visibility="{Binding CanStopSelected, Converter={StaticResource VisibleWhen}}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="7" Height="7" CornerRadius="2" Background="{StaticResource RedText}" />
                                        <TextBlock Text="{Binding StopSelectedText}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Filter}"
                                             IsChecked="{Binding StateFilter, Converter={StaticResource Equals}, ConverterParameter={x:Static local:TestFilter.All}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="All" Style="{StaticResource FilterLabel}" />
                                        <TextBlock Text="{Binding SelectedNode.Done}" Style="{StaticResource FilterCount}" Tag="{StaticResource Subtle}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Filter}"
                                             IsChecked="{Binding StateFilter, Converter={StaticResource Equals}, ConverterParameter={x:Static local:TestFilter.Passed}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Passed" Style="{StaticResource FilterLabel}" />
                                        <TextBlock Text="{Binding SelectedNode.Passed}" Style="{StaticResource FilterCount}" Tag="{StaticResource Faint}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Filter}"
                                             IsChecked="{Binding StateFilter, Converter={StaticResource Equals}, ConverterParameter={x:Static local:TestFilter.Failed}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Failed" Style="{StaticResource FilterLabel}" />
                                        <TextBlock Text="{Binding SelectedNode.Failed}" Style="{StaticResource FilterCount}" Tag="{StaticResource RedText}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Filter}"
                                             IsChecked="{Binding StateFilter, Converter={StaticResource Equals}, ConverterParameter={x:Static local:TestFilter.Aborted}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Aborted" Style="{StaticResource FilterLabel}" />
                                        <TextBlock Text="{Binding SelectedNode.Aborted}" Style="{StaticResource FilterCount}" Tag="{StaticResource AmberText}" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Tests, newest first: the running one on top, then the finished ones -->
                    <ScrollViewer x:Name="TestScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="6">
                            <Border Height="46" Padding="12,0" CornerRadius="12" Background="{StaticResource BlueSoft}"
                                    Visibility="{Binding RunningTest, Converter={StaticResource VisibleWhen}}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Width="28" Text="{Binding RunningTest.No}" Style="{StaticResource MonoText}" FontSize="11"
                                               Foreground="{StaticResource Blue}" />
                                    <Control DockPanel.Dock="Left" Margin="14,0,0,0" Template="{StaticResource Spinner}" Focusable="False" VerticalAlignment="Center" />
                                    <TextBlock DockPanel.Dock="Right" Width="48" Margin="14,0,0,0" Text="{Binding SelectedNode.RunningForText}" TextAlignment="Right"
                                               Style="{StaticResource MonoText}" Foreground="{StaticResource Blue}" />
                                    <TextBlock DockPanel.Dock="Right" Text="Running" Margin="14,0,0,0" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Blue}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding RunningTest.Name}" Margin="14,0,0,0" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Border>

                            <ItemsControl ItemsSource="{Binding VisibleTests}" ItemTemplate="{StaticResource TestTemplate}" Focusable="False" />

                            <Button Style="{StaticResource Btn.LinkMuted}" Content="{Binding ShowMoreText}" Height="40" Margin="54,0,0,0"
                                    HorizontalAlignment="Left" FontWeight="Normal" Click="OnShowMore"
                                    Visibility="{Binding HasMore, Converter={StaticResource VisibleWhen}}" />
                            <TextBlock Text="{Binding EmptyText}" Margin="54,12" Foreground="{StaticResource Subtle}"
                                       Visibility="{Binding EmptyText, Converter={StaticResource VisibleWhen}}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ Box 2: the log panel ═════════════════════════════════════════ -->
        <Grid Grid.Row="1" Height="290" Margin="24,0" Visibility="{Binding LogsOpen, Converter={StaticResource VisibleWhen}}">
            <Border Style="{StaticResource CardShadowUp}" CornerRadius="18,18,0,0" />
            <Border Background="White" BorderBrush="#0F0B0D12" BorderThickness="1,1,1,0" CornerRadius="18,18,0,0" local:Look.ClipToCorners="True">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Width="36" Height="4" Margin="0,8,0,0" CornerRadius="2" Background="{StaticResource TrackDark}" />

                    <Border DockPanel.Dock="Top" Padding="20,8,14,12" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <local:PathIcon DockPanel.Dock="Left" Data="{StaticResource Geo.Terminal}" Foreground="{StaticResource Ink}" />
                            <TextBlock DockPanel.Dock="Left" Text="Logs" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border DockPanel.Dock="Left" Margin="12,0,0,0" Padding="3" CornerRadius="9" Background="{StaticResource Chip}"
                                    Visibility="{Binding IsMulti, Converter={StaticResource VisibleWhen}}">
                                <ListBox ItemsSource="{Binding LogTabs}" SelectedIndex="{Binding LogTab}" ItemContainerStyle="{StaticResource LogTab}"
                                         FocusVisualStyle="{x:Null}" BorderThickness="0" Background="Transparent">
                                    <ListBox.Template>
                                        <ControlTemplate TargetType="ListBox">
                                            <ItemsPresenter />
                                        </ControlTemplate>
                                    </ListBox.Template>
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </Border>

                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Margin="12,0,0,0" ToolTip="Close" Click="OnCloseLogs">
                                <local:PathIcon Data="{StaticResource Geo.Close}" Width="12" Height="12" StrokeThickness="1.4" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Margin="12,0,0,0" ToolTip="Copy" Click="OnCopyLog">
                                <local:PathIcon Data="{StaticResource Geo.Copy}" Width="13" Height="13" />
                            </Button>

                            <!-- Live / Done pill -->
                            <Border DockPanel.Dock="Right" Height="26" Padding="10,0" CornerRadius="13">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BlueChip}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource Chip}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource Blue}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                        <Setter Property="Fill" Value="{StaticResource Faint}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Live" />
                                                <Setter Property="Foreground" Value="{StaticResource Blue}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="False">
                                                        <Setter Property="Text" Value="Done" />
                                                        <Setter Property="Foreground" Value="{StaticResource Subtle}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                            <Border />
                        </DockPanel>
                    </Border>

                    <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Margin="8" ItemsSource="{Binding VisibleLog}" ItemTemplate="{StaticResource LogTemplate}" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
