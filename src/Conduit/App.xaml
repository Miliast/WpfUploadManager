<!--
    Conduit design system, 1:1 from the Paper file: colours, fonts, icons, buttons and the few shared controls.
    Every view only references these keys – a later switch to the WPF Fluent theme (.NET 9+) only has to touch this file.
-->
<Application x:Class="Conduit.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Conduit"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- ══ Colours ═══════════════════════════════════════════════════════ -->
        <SolidColorBrush x:Key="Blue" Color="#1F4BFF" />
        <SolidColorBrush x:Key="BlueHover" Color="#1A40E0" />
        <SolidColorBrush x:Key="BlueSoft" Color="#F3F6FF" />
        <SolidColorBrush x:Key="BlueChip" Color="#EEF2FF" />
        <SolidColorBrush x:Key="BlueTile" Color="#F0F3FF" />
        <SolidColorBrush x:Key="BlueRing" Color="#C9D4FF" />
        <SolidColorBrush x:Key="BlueLight" Color="#7D97FF" />

        <SolidColorBrush x:Key="Ink" Color="#0B0D12" />
        <SolidColorBrush x:Key="InkHover" Color="#2A2E38" />
        <SolidColorBrush x:Key="Black" Color="#000000" />
        <SolidColorBrush x:Key="Body" Color="#2A2F3A" />
        <SolidColorBrush x:Key="Muted" Color="#5B6270" />
        <SolidColorBrush x:Key="Subtle" Color="#8A909C" />
        <SolidColorBrush x:Key="Faint" Color="#A0A6B1" />
        <SolidColorBrush x:Key="Faintest" Color="#B4B9C3" />
        <SolidColorBrush x:Key="Dot" Color="#C4C9D2" />
        <SolidColorBrush x:Key="Dashed" Color="#C9CDD3" />
        <SolidColorBrush x:Key="Skeleton" Color="#D5D9E0" />
        <SolidColorBrush x:Key="SkeletonLight" Color="#E1E4E9" />
        <SolidColorBrush x:Key="Hairline" Color="#E3E5E8" />
        <SolidColorBrush x:Key="Line" Color="#E6E8EC" />
        <SolidColorBrush x:Key="LineSoft" Color="#F0F1F3" />
        <SolidColorBrush x:Key="Chip" Color="#F2F3F5" />
        <SolidColorBrush x:Key="ChipHover" Color="#E7E9ED" />
        <SolidColorBrush x:Key="Hover" Color="#F6F7F9" />
        <SolidColorBrush x:Key="Page" Color="#F6F6F7" />
        <SolidColorBrush x:Key="Track" Color="#ECEDEF" />
        <SolidColorBrush x:Key="TrackDark" Color="#DADDE2" />
        <SolidColorBrush x:Key="White" Color="#FFFFFF" />

        <!-- Shell + sheet (Paper 9c / 11b): the window itself is one flat grey, the content sits on a single white sheet. -->
        <SolidColorBrush x:Key="Shell" Color="#E6E7EB" />
        <SolidColorBrush x:Key="SheetLine" Color="#140B0D12" />
        <!-- Log panel inside the sheet: grey panel, darker segmented filter track, white well, pink row of a failed test. -->
        <SolidColorBrush x:Key="LogPanel" Color="#F1F2F5" />
        <SolidColorBrush x:Key="LogSegment" Color="#E4E6EA" />
        <SolidColorBrush x:Key="LogWellLine" Color="#120B0D12" />
        <SolidColorBrush x:Key="FailRow" Color="#FDF1F1" />

        <SolidColorBrush x:Key="Green" Color="#12A150" />
        <SolidColorBrush x:Key="GreenSoft" Color="#E4F5EB" />
        <SolidColorBrush x:Key="Red" Color="#E5383B" />
        <SolidColorBrush x:Key="RedText" Color="#C2262A" />
        <SolidColorBrush x:Key="RedSoft" Color="#FDEEEE" />
        <SolidColorBrush x:Key="RedSoftHover" Color="#FBE1E1" />
        <SolidColorBrush x:Key="RedLine" Color="#F3CACB" />
        <SolidColorBrush x:Key="Amber" Color="#E89B0C" />
        <SolidColorBrush x:Key="AmberText" Color="#9A6700" />
        <SolidColorBrush x:Key="AmberSoft" Color="#FDF3E1" />
        <SolidColorBrush x:Key="WarnRow" Color="#FFF7E8" />
        <SolidColorBrush x:Key="WarnTag" Color="#B87A00" />
        <SolidColorBrush x:Key="WarnText" Color="#7A5300" />
        <SolidColorBrush x:Key="Purple" Color="#7A3FE4" />

        <FontFamily x:Key="Sans">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="Mono">JetBrains Mono, Cascadia Mono, Consolas</FontFamily>

        <!-- ══ Converters ════════════════════════════════════════════════════ -->
        <local:VisibleWhen x:Key="VisibleWhen" />
        <local:VisibleWhen x:Key="CollapsedWhen" Invert="True" />
        <local:StarConverter x:Key="Star" />
        <local:PieConverter x:Key="Pie" />
        <local:EqualsConverter x:Key="Equals" />

        <!-- ══ Icons: SVG path data from Paper (viewBox 14 unless the comment says otherwise) ═ -->
        <Geometry x:Key="Geo.Folder">M2.5,4.5 A1,1 0 0 1 3.5,3.5 H6.5 L8,5 H12.5 A1,1 0 0 1 13.5,6 V12 A1,1 0 0 1 12.5,13 H3.5 A1,1 0 0 1 2.5,12 Z</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.Spec">M6,2.5 H10 M7,2.5 V6.5 L3.5,13 H12.5 L9,6.5 V2.5</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.Doc">M4,2.5 H9 L12,5.5 V13.5 H4 Z</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.Container">M4.5,5 H11.5 A1.5,1.5 0 0 1 13,6.5 V10.5 A1.5,1.5 0 0 1 11.5,12 H4.5 A1.5,1.5 0 0 1 3,10.5 V6.5 A1.5,1.5 0 0 1 4.5,5 Z M5,5 V3.5 H11 V5</Geometry><!-- 16 -->
        <Geometry x:Key="Geo.ChevronDown">M2.5,4 L5,6.5 L7.5,4</Geometry><!-- 10 -->
        <Geometry x:Key="Geo.ChevronRight">M3.5,2 L6.5,5 L3.5,8</Geometry><!-- 10 -->
        <Geometry x:Key="Geo.Play">M2,1.5 V8.5 L8,5 Z</Geometry><!-- 10, filled -->
        <Geometry x:Key="Geo.Search">M6,2 A4,4 0 1 1 6,10 A4,4 0 1 1 6,2 Z M9,9 L12,12</Geometry>
        <Geometry x:Key="Geo.Upload">M7,9.5 V3 M4.5,5.5 L7,3 L9.5,5.5 M2.5,10 V11 A0.5,0.5 0 0 0 3,11.5 H11 A0.5,0.5 0 0 0 11.5,11 V10</Geometry>
        <Geometry x:Key="Geo.Download">M7,2.5 V9 M4.5,6.5 L7,9 L9.5,6.5 M2.5,10 V11 A0.5,0.5 0 0 0 3,11.5 H11 A0.5,0.5 0 0 0 11.5,11 V10</Geometry>
        <Geometry x:Key="Geo.Export">M7,9 V2 M4.2,4.6 L7,1.8 L9.8,4.6 M2.5,8.5 V11 A1,1 0 0 0 3.5,12 H10.5 A1,1 0 0 0 11.5,11 V8.5</Geometry>
        <Geometry x:Key="Geo.Refresh">M2.5,7 A4.5,4.5 0 1 0 3.8,3.8 M2.5,2.5 V5 H5</Geometry>
        <Geometry x:Key="Geo.Cloud">M5,12.5 A3.5,3.5 0 0 1 4.6,5.5 A4.5,4.5 0 0 1 13.3,6 A3.25,3.25 0 0 1 13,12.5 M9,8.5 V14.5 M6.8,12.3 L9,14.5 L11.2,12.3</Geometry><!-- 18 -->
        <Geometry x:Key="Geo.Info">M7,1.5 A5.5,5.5 0 1 1 7,12.5 A5.5,5.5 0 1 1 7,1.5 Z M7,6.2 V9.5 M7,4.4 V4.5</Geometry>
        <Geometry x:Key="Geo.Terminal">M3.5,2.5 H10.5 A2,2 0 0 1 12.5,4.5 V9.5 A2,2 0 0 1 10.5,11.5 H3.5 A2,2 0 0 1 1.5,9.5 V4.5 A2,2 0 0 1 3.5,2.5 Z M4,6 L5.8,7.5 L4,9 M7.5,9 H10</Geometry>
        <Geometry x:Key="Geo.Copy">M6,4.5 H10 A1.5,1.5 0 0 1 11.5,6 V10 A1.5,1.5 0 0 1 10,11.5 H6 A1.5,1.5 0 0 1 4.5,10 V6 A1.5,1.5 0 0 1 6,4.5 Z M9.5,4.5 V3 A0.5,0.5 0 0 0 9,2.5 H3 A0.5,0.5 0 0 0 2.5,3 V9 A0.5,0.5 0 0 0 3,9.5 H4.5</Geometry>
        <Geometry x:Key="Geo.Close">M3.5,3.5 L10.5,10.5 M10.5,3.5 L3.5,10.5</Geometry>
        <Geometry x:Key="Geo.Sparkle">M7,1 Q7.6,6.4 13,7 Q7.6,7.6 7,13 Q6.4,7.6 1,7 Q6.4,6.4 7,1 Z</Geometry><!-- filled -->
        <Geometry x:Key="Geo.Check8">M1.5,4.2 L3.2,5.8 L6.5,2.4</Geometry><!-- 8 -->
        <Geometry x:Key="Geo.Cross8">M2,2 L6,6 M6,2 L2,6</Geometry><!-- 8 -->

        <!-- ══ Images (window / taskbar) ═════════════════════════════════════ -->
        <DrawingImage x:Key="LogoImage">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H32 V32 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Ink}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="2,2,28,28" RadiusX="8" RadiusY="8" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="{StaticResource Blue}">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="16,16" RadiusX="5.5" RadiusY="5.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <Pen x:Key="ThumbPen" Brush="{StaticResource Ink}" Thickness="1.4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />

        <DrawingImage x:Key="Thumb.Stop">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource RedText}">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="3,3,8,8" RadiusX="1.5" RadiusY="1.5" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="Thumb.Logs">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z" />
                    <GeometryDrawing Geometry="{StaticResource Geo.Terminal}" Pen="{StaticResource ThumbPen}" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <DrawingImage x:Key="Thumb.Export">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H14 V14 H0 Z" />
                    <GeometryDrawing Geometry="{StaticResource Geo.Export}" Pen="{StaticResource ThumbPen}" />
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Taskbar overlay when a run finished without failures: green circle with a white check. -->
        <DrawingImage x:Key="Overlay.Check">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M0,0 H16 V16 H0 Z" />
                    <GeometryDrawing Brush="{StaticResource Green}">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="1.5" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="8,8" RadiusX="7.2" RadiusY="7.2" />
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M4.6,8.3 L7,10.5 L11.4,5.8">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="1.8" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- ══ Text ══════════════════════════════════════════════════════════ -->
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
        </Style>

        <Style x:Key="MonoText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- ══ Cards: white surface with hairline + soft shadow ═══════════════
             The shadow lives on its own layer behind the card, so text on the card keeps ClearType. -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#140B0D12" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="CardShadow" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Color="#0B0D12" Opacity="0.08" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardShadowSmall" TargetType="Border" BasedOn="{StaticResource CardShadow}">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#0B0D12" Opacity="0.05" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardShadowUp" TargetType="Border" BasedOn="{StaticResource CardShadow}">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="90" Color="#0B0D12" Opacity="0.1" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══ Buttons ═══════════════════════════════════════════════════════
             One flat template; each variant only sets colours, radius (local:Look.CornerRadius) and hover. -->
        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Black}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding (local:Look.CornerRadius), RelativeSource={RelativeSource TemplatedParent}}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="False" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Blue "Run pipelines". -->
        <Style x:Key="Btn.Primary" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Blue}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="local:Look.CornerRadius" Value="9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BlueHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#EEF0F3" />
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Black "Open folder", "Get X data", "Auto-fill". -->
        <Style x:Key="Btn.Dark" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="local:Look.CornerRadius" Value="9" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource InkHover}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Chip}" />
                    <Setter Property="Foreground" Value="{StaticResource Faint}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Grey pill "Add file". -->
        <Style x:Key="Btn.Chip" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource Chip}" />
            <Setter Property="local:Look.CornerRadius" Value="15" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ChipHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- White with hairline: "Get X data" after loading. -->
        <Style x:Key="Btn.Outline" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="local:Look.CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Soft red "Stop all". -->
        <Style x:Key="Btn.Danger" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="{StaticResource RedSoft}" />
            <Setter Property="Foreground" Value="{StaticResource RedText}" />
            <Setter Property="local:Look.CornerRadius" Value="15" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedSoftHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Red outline "Stop Payments". -->
        <Style x:Key="Btn.DangerOutline" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource RedText}" />
            <Setter Property="BorderBrush" Value="{StaticResource RedLine}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="local:Look.CornerRadius" Value="14" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource RedSoft}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Icon buttons in the log bar. -->
        <Style x:Key="Btn.Ghost" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="local:Look.CornerRadius" Value="8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Chip}" />
                    <Setter Property="Foreground" Value="{StaticResource Black}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Text links: blue ("Try a sample project") and grey ("Replace", "Show 19 earlier tests"). -->
        <Style x:Key="Btn.Link" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="{StaticResource Blue}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#1233C4" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Btn.LinkMuted" TargetType="Button" BasedOn="{StaticResource Btn.Link}">
            <Setter Property="Foreground" Value="{StaticResource Subtle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Black}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Halves of the black "Export to X | ▾" split button. -->
        <Style x:Key="Btn.OnDark" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#262A33" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#B3FFFFFF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ Blue spinner of the running test ══════════════════════════════ -->
        <ControlTemplate x:Key="Spinner" TargetType="Control">
            <Grid x:Name="Root" Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform />
                </Grid.RenderTransform>
                <Ellipse Stroke="{StaticResource BlueRing}" StrokeThickness="2" />
                <Path Data="M8,1 A7,7 0 0 1 15,8" Stroke="{StaticResource Blue}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
            <ControlTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Root"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ══ Slim scroll bars ══════════════════════════════════════════════ -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bd" Background="{StaticResource Skeleton}" CornerRadius="3" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Faintest}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Faint}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb Style="{StaticResource ScrollThumb}" />
                            </Track.Thumb>
                        </Track>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Track x:Name="PART_Track">
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource ScrollThumb}" />
                                    </Track.Thumb>
                                </Track>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══ Menus & tooltips ══════════════════════════════════════════════ -->
        <Style TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="FontFamily" Value="{StaticResource Sans}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="10,6,10,14">
                            <Border Style="{StaticResource CardShadow}" CornerRadius="10" />
                            <Border Style="{StaticResource Card}" CornerRadius="10" Padding="4">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource Black}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="10,7" MinWidth="190">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Chip}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Margin="6,4" Background="{StaticResource LineSoft}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{StaticResource Ink}" CornerRadius="6" Padding="8,5">
                            <ContentPresenter TextElement.Foreground="White" TextElement.FontSize="12"
                                              TextElement.FontFamily="{StaticResource Sans}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
