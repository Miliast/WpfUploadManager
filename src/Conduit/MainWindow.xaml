<!--
    Conduit main window: the top bar shared by all screens, plus the two screen groups from the Paper file:
      SetupView – 1 Setup empty, 2 Setup filled
      RunView   – 3/4 Running multi (± logs), 5 Running single, 6 Finished single
    Screen 7 (Windows taskbar progress) lives in TaskbarItemInfo below + MainWindow.xaml.cs.
-->
<Window x:Class="Conduit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Conduit"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:Workspace}"
        Title="Conduit"
        Width="1280" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource LogoImage}"
        FontFamily="{StaticResource Sans}" FontSize="13"
        Foreground="{StaticResource Black}" Background="White"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbStop" Description="Stop" ImageSource="{StaticResource Thumb.Stop}" Click="OnThumbStop" />
                <ThumbButtonInfo x:Name="ThumbLogs" Description="Logs" ImageSource="{StaticResource Thumb.Logs}" Click="OnThumbLogs" />
                <ThumbButtonInfo x:Name="ThumbExport" Description="Export to X" ImageSource="{StaticResource Thumb.Export}" Click="OnExport" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Terminal toggle: light pill while running, outlined square when finished, black when the log panel is open. -->
        <Style x:Key="Btn.Terminal" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource Chip}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="local:Look.CornerRadius" Value="15" />
            <Setter Property="ToolTip" Value="Logs (Ctrl+L)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="local:Look.CornerRadius" Value="8" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsFinished}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource ChipHover}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsFinished}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding LogsOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Ink}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ══ Top bar ═══════════════════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Height="56" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Padding" Value="20,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRun}" Value="True">
                            <Setter Property="Padding" Value="20,0,16,0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <DockPanel LastChildFill="False">

                <!-- Logo · Conduit / New run -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Padding="0" Click="OnBrandClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="Start a new run" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="6" Background="{StaticResource Ink}">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource Blue}" />
                            </Border>
                            <TextBlock Text="Conduit" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="/" Margin="14,0" Foreground="{StaticResource Faintest}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Crumb}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Setup: status + Run pipelines -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding MissingText}" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding IsReady, Converter={StaticResource CollapsedWhen}}" />
                        <TextBlock Foreground="{StaticResource Muted}" Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                            <Run Text="Ready" Foreground="{StaticResource Green}" FontWeight="SemiBold" /><Run Text="{Binding PlannedTestsText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <Button Style="{StaticResource Btn.Primary}" Height="34" Padding="14,0,16,0" Margin="14,0,0,0"
                            IsEnabled="{Binding IsReady}" Click="OnRunClick" ToolTip="Ctrl+Enter">
                        <StackPanel Orientation="Horizontal">
                            <local:PathIcon Data="{StaticResource Geo.Play}" Box="10" Width="10" Height="10" Filled="True" />
                            <TextBlock Text="Run pipelines" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Running / Finished: timer · terminal · Stop  |  terminal · Export to X ▾ -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                    <Border Height="30" CornerRadius="15" Padding="12,0" Margin="0,0,14,0" Background="{StaticResource Chip}"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Blue}" />
                            <TextBlock Text="{Binding ElapsedText}" Margin="8,0,0,0" Style="{StaticResource MonoText}" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Btn.Terminal}" Click="OnToggleLogs">
                        <local:PathIcon Data="{StaticResource Geo.Terminal}" Width="15" Height="15" />
                    </Button>

                    <Button Style="{StaticResource Btn.Danger}" Height="30" Padding="14,0" Margin="14,0,0,0" Click="OnStopAll"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource RedText}" />
                            <TextBlock Text="{Binding StopText}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Height="32" CornerRadius="8" Margin="14,0,0,0" Background="{StaticResource Ink}"
                            Visibility="{Binding IsFinished, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.OnDark}" local:Look.CornerRadius="8,0,0,8" Padding="11,0,12,0" Height="32"
                                    IsEnabled="{Binding CanExport}" Click="OnExport">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="14" Height="14">
                                        <local:PathIcon Data="{StaticResource Geo.Export}" StrokeThickness="1.5"
                                                        Visibility="{Binding IsExported, Converter={StaticResource CollapsedWhen}}" />
                                        <local:PathIcon Data="{StaticResource Geo.Check8}" Box="8" Width="11" Height="11" StrokeThickness="1.5"
                                                        Visibility="{Binding IsExported, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ExportText}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Border Width="1" Margin="0,8" Background="#33FFFFFF" />
                            <Button x:Name="ExportMore" Style="{StaticResource Btn.OnDark}" local:Look.CornerRadius="0,8,8,0" Padding="9,0" Height="32"
                                    Click="OnExportMore" ToolTip="More export options">
                                <local:PathIcon Data="{StaticResource Geo.ChevronDown}" Box="10" Width="10" Height="10" StrokeThickness="1.5" />
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Save results as JSON…" Click="OnSaveJson" />
                                        <MenuItem Header="Copy summary" Click="OnCopySummary" />
                                        <Separator />
                                        <MenuItem Header="New run" Click="OnNewRun" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Screens ═══════════════════════════════════════════════════════ -->
        <Grid>
            <local:SetupView x:Name="Setup" Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}" />
            <local:RunView Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />
        </Grid>
    </DockPanel>
</Window>
