<!--
    MainWindow – the grey shell around every screen (Paper "9c · Running" / "11b · Setup": grey shell, white sheet).

    ┌──────────────────────────────────────────────────────────────────────────────────────────┐
    │ ■ Conduit  /  Run #1042                      ● 0:47   [>_]   ■ Stop all      –    □    ✕  │  top bar, 56 high
    ├───────────────────────────┬──────────────────────────────────────────────────────────────┤
    │ sidebar (on the shell)    │  white sheet                                                 │  SetupView / RunView
    └───────────────────────────┴──────────────────────────────────────────────────────────────┘

    What this file owns:
      · the window frame ....... WindowChrome removes the native title bar; the top bar below is the title bar.
                                 It can be dragged, double-clicked to maximise, and keeps the resize borders.
      · the top bar ............ logo + breadcrumb on the left; status + actions on the right; then – □ ✕
      · the two screen groups .. SetupView (screens 1–2) and RunView (screens 3–6), switched by Workspace.Screen
      · the busy overlay ....... dims the screens while a call to X is running
    Screen 7 (Windows taskbar progress) lives in TaskbarItemInfo below + MainWindow.xaml.cs.

    Sidebar and sheet are drawn by the views themselves, because the sidebar content differs per screen.
-->
<Window x:Class="Conduit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Conduit"
        xmlns:ll="clr-namespace:LogoLoader"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=local:Workspace}"
        Title="Conduit"
        Width="1280" Height="840" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Icon="{StaticResource LogoImage}"
        FontFamily="{StaticResource Sans}" FontSize="13"
        Foreground="{StaticResource Black}" Background="{StaticResource Shell}"
        UseLayoutRounding="True"
        PreviewKeyDown="OnPreviewKeyDown">

    <!--
        Custom title bar. CaptionHeight = height of the top bar, so the whole bar drags the window.
        Anything clickable inside it must set WindowChrome.IsHitTestVisibleInChrome="True" (done on the panels below),
        otherwise the click would start a drag. GlassFrameThickness keeps the native window shadow.
    -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbStop" Description="Stop" ImageSource="{StaticResource Thumb.Stop}" Click="OnThumbStop" />
                <ThumbButtonInfo x:Name="ThumbLogs" Description="Logs" ImageSource="{StaticResource Thumb.Logs}" Click="OnThumbLogs" />
                <ThumbButtonInfo x:Name="ThumbExport" Description="Export to X" ImageSource="{StaticResource Thumb.Export}" Click="OnExport" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>

    <Window.Resources>
        <!-- Terminal toggle: light pill while running, outlined square when finished, black when the log panel is open. -->
        <Style x:Key="Btn.Terminal" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{StaticResource Chip}" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="local:Look.CornerRadius" Value="15" />
            <Setter Property="ToolTip" Value="Logs (Ctrl+L)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFinished}" Value="True">
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="32" />
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="local:Look.CornerRadius" Value="8" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsFinished}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource ChipHover}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        <Condition Binding="{Binding IsFinished}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding LogsOpen}" Value="True">
                    <Setter Property="Background" Value="{StaticResource Ink}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Ink}" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Window buttons (minimise, maximise / restore, close): 46 wide, as high as the top bar, 10 px glyph with a
            1 px stroke in the button's Foreground. Hover = a faint dark veil; the close button turns Windows-red.
        -->
        <Style x:Key="Btn.Caption" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#140B0D12" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#240B0D12" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Btn.Caption.Close" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#C50F1F" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!--
        A maximised window with WindowChrome hangs 7 px over every screen edge; this padding pulls the content back in.
        (7 = resize border of a standard window at 100 % scaling.)
    -->
    <Border>
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Padding" Value="0" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="Padding" Value="7" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

    <DockPanel>

        <!-- ══ Top bar ═══════════════════════════════════════════════════════════════════════════════
             56 high, on the shell (no background, no divider). 20 px from the left edge; the window buttons
             touch the right edge. Order from the right: ✕ □ – · 8 px · actions (14 px apart) · status. -->
        <Border DockPanel.Dock="Top" Height="56" Padding="20,0,0,0">

            <DockPanel LastChildFill="False">

                <!-- ── Window buttons ─────────────────────────────────────────────────────────────── -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource Btn.Caption}" ToolTip="Minimise" Click="OnMinimize">
                        <Path Data="M0,5 H10" Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button Click="OnMaximizeRestore">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
                                <Setter Property="ToolTip" Value="Maximise" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="ToolTip" Value="Restore" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <!-- one rounded square -->
                                    <Setter Property="Data" Value="M2,0.5 H8 A1.5,1.5 0 0 1 9.5,2 V8 A1.5,1.5 0 0 1 8,9.5 H2 A1.5,1.5 0 0 1 0.5,8 V2 A1.5,1.5 0 0 1 2,0.5 Z" />
                                    <Style.Triggers>
                                        <!-- maximised: two overlapping squares -->
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Data" Value="M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource Btn.Caption.Close}" ToolTip="Close" Click="OnCloseWindow">
                        <Path Data="M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5" Width="10" Height="10" StrokeThickness="1"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>

                <!-- ── Logo · Conduit / New run ───────────────────────────────────────────────────────
                     Logo 22 × 22 (radius 6, blue 8 px dot), "Conduit" 15 Bold 10 px to its right, then "/" and the
                     breadcrumb 14 px apart. Only the logo button is clickable; the texts drag the window. -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Padding="0" Click="OnBrandClick" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Btn}">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFinished}" Value="True">
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="ToolTip" Value="Start a new run" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="22" Height="22">
                                <Border x:Name="BrandMark" CornerRadius="6" Background="{StaticResource Ink}">
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource Blue}" />
                                </Border>
                                <!-- Own logo (Assets\logo.png), set in code-behind when present. -->
                                <Image x:Name="BrandImage" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <TextBlock Text="Conduit" Margin="10,0,0,0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="/" Margin="14,0" Foreground="{StaticResource Faintest}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Crumb}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- ── Setup: "5 files missing" / "Ready · 160 tests" + Run pipelines (34 high) ───────── -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}">
                    <Grid VerticalAlignment="Center">
                        <TextBlock Text="{Binding MissingText}" Foreground="{StaticResource Muted}"
                                   Visibility="{Binding IsReady, Converter={StaticResource CollapsedWhen}}" />
                        <TextBlock Foreground="{StaticResource Muted}" Visibility="{Binding IsReady, Converter={StaticResource VisibleWhen}}">
                            <Run Text="Ready" Foreground="{StaticResource Green}" FontWeight="SemiBold" /><Run Text="{Binding PlannedTestsText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <Button Style="{StaticResource Btn.Primary}" Height="34" Padding="14,0,16,0" Margin="14,0,0,0"
                            IsEnabled="{Binding IsReady}" Click="OnRunClick" ToolTip="Ctrl+Enter">
                        <StackPanel Orientation="Horizontal">
                            <local:PathIcon Data="{StaticResource Geo.Play}" Box="10" Width="10" Height="10" Filled="True" />
                            <TextBlock Text="Run pipelines" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- ── Running: timer pill · logs toggle · Stop   |   Finished: logs toggle · Export to X ▾ ──
                     All 30 high (Export 32) and 14 px apart. -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True"
                            Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}">
                    <Border Height="30" CornerRadius="15" Padding="12,0" Margin="0,0,14,0" Background="{StaticResource Chip}"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Blue}" />
                            <TextBlock Text="{Binding ElapsedText}" Margin="8,0,0,0" Style="{StaticResource MonoText}" FontWeight="Medium" />
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource Btn.Terminal}" Click="OnToggleLogs">
                        <local:PathIcon Data="{StaticResource Geo.Terminal}" Width="15" Height="15" />
                    </Button>

                    <Button Style="{StaticResource Btn.Danger}" Height="30" Padding="14,0" Margin="14,0,0,0" Click="OnStopAll"
                            Visibility="{Binding IsRunning, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="8" CornerRadius="2" Background="{StaticResource RedText}" />
                            <TextBlock Text="{Binding StopText}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Height="32" CornerRadius="8" Margin="14,0,0,0" Background="{StaticResource Ink}"
                            Visibility="{Binding IsFinished, Converter={StaticResource VisibleWhen}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Btn.OnDark}" local:Look.CornerRadius="8,0,0,8" Padding="11,0,12,0" Height="32"
                                    IsEnabled="{Binding CanExport}" Click="OnExport">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="14" Height="14">
                                        <local:PathIcon Data="{StaticResource Geo.Export}" StrokeThickness="1.5"
                                                        Visibility="{Binding IsExported, Converter={StaticResource CollapsedWhen}}" />
                                        <local:PathIcon Data="{StaticResource Geo.Check8}" Box="8" Width="11" Height="11" StrokeThickness="1.5"
                                                        Visibility="{Binding IsExported, Converter={StaticResource VisibleWhen}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding ExportText}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Border Width="1" Margin="0,8" Background="#33FFFFFF" />
                            <Button x:Name="ExportMore" Style="{StaticResource Btn.OnDark}" local:Look.CornerRadius="0,8,8,0" Padding="9,0" Height="32"
                                    Click="OnExportMore" ToolTip="More export options">
                                <local:PathIcon Data="{StaticResource Geo.ChevronDown}" Box="10" Width="10" Height="10" StrokeThickness="1.5" />
                                <Button.ContextMenu>
                                    <ContextMenu Placement="Bottom">
                                        <MenuItem Header="Save results as JSON…" Click="OnSaveJson" />
                                        <MenuItem Header="Copy summary" Click="OnCopySummary" />
                                        <Separator />
                                        <MenuItem Header="New run" Click="OnNewRun" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══ Screens ═══════════════════════════════════════════════════════════════════════════════
             Both views draw their own sidebar (on the shell) and their own white sheet. -->
        <Grid>
            <local:SetupView x:Name="Setup" Visibility="{Binding IsSetup, Converter={StaticResource VisibleWhen}}" />
            <local:RunView Visibility="{Binding IsRun, Converter={StaticResource VisibleWhen}}" />

            <!-- Busy: the page dims softly and the logo loader builds up in the middle. Faded in and out by MainWindow.xaml.cs:
                 in when the call to X takes noticeably long, out only once the loader reports that the logo has landed. -->
            <Grid x:Name="BusyOverlay" Visibility="Collapsed" Opacity="0">
                <Border Background="{StaticResource Shell}" Opacity="0.82" />
                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,40">
                    <Border Style="{StaticResource CardShadow}" CornerRadius="100" />
                    <ll:PixelLogoLoader x:Name="Loader" LogoSize="48" Resolution="12"
                                        Source="{StaticResource LogoImage}"
                                        Text="{Binding BusyText}" IsActive="{Binding IsBusy}" />
                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
    </Border>
</Window>
