<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Conduit UI demo: the Paper design as XAML + code-behind (no NuGet packages):
      App.xaml        – design tokens from Paper: colours, fonts, icons, buttons, scroll bars, menus
      MainWindow      – top bar, shortcuts, Windows taskbar progress (screen 7)
      SetupView       – screens 1–2: project sidebar, the five fields, "Get data from X", drag & drop
      RunView         – screens 3–6: node tabs / summary, filters, test list, log panel
      Workspace       – state + logic of all screens (the views bind to it)
      PipelineNode    – one pipeline node, its tests and a fake runner that advances them
      GlowSweep       – aurora glow overlay for auto-fill (look in GlowSweep.xaml, motion in GlowSweep.xaml.cs)
      PixelLogoLoader – linked from src/LogoLoader: the logo-tile loader shown while fetching or exporting
    Moving to .NET 10 later = change TargetFramework to net10.0-windows, nothing else.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Conduit</RootNamespace>
    <AssemblyName>Conduit</AssemblyName>
    <!-- Lets the project compile on macOS/Linux; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- The pixel logo loader is shared with src/LogoLoader as a linked file (one source, no extra project). -->
    <Compile Include="..\LogoLoader\PixelLogoLoader.cs" Link="PixelLogoLoader.cs" />
    <!-- Optional own logo: put Assets\logo.png next to the project – it replaces the Conduit mark in the loader, top bar and taskbar. -->
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
