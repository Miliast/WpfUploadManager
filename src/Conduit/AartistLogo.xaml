                        <TransformGroup>
                            <SkewTransform x:Name="LeanA2" CenterY="85.8" />
                            <TranslateTransform x:Name="SlideA2" />
                        </TransformGroup>
                    </Canvas.RenderTransform>

                    <Canvas Clip="{StaticResource Behind.A2}">
                        <Canvas x:Name="MoveR">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <SkewTransform x:Name="LeanR" CenterY="85.8" />
                                    <TranslateTransform x:Name="SlideR" />
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <Canvas Clip="{StaticResource Behind.R}">
                                <Canvas x:Name="MoveT">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <SkewTransform x:Name="LeanT" CenterY="85.8" />
                                            <TranslateTransform x:Name="SlideT" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>

                                    <Canvas Clip="{StaticResource Behind.T}">
                                        <Path x:Name="GlyphI" Data="{StaticResource Logo.I}" Fill="Black">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="SlideSmallI" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="GlyphS" Data="{StaticResource Logo.S}" Fill="Black">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="SlideSmallS" />
                                            </Path.RenderTransform>
                                        </Path>
                                        <Path x:Name="GlyphT" Data="{StaticResource Logo.T}" Fill="Black">
                                            <Path.RenderTransform>
                                                <TranslateTransform x:Name="SlideSmallT" />
                                            </Path.RenderTransform>
                                        </Path>
                                    </Canvas>
                                    <Canvas Clip="{StaticResource Clip.T}">
                                        <Path Data="{StaticResource Logo.Aart}" Fill="{StaticResource LogoBlue}" />
                                        <Path x:Name="TintT" Data="{StaticResource Logo.Aart}" Opacity="0">
                                            <Path.Fill>
                                                <LinearGradientBrush MappingMode="Absolute" StartPoint="160,0" EndPoint="630,0" GradientStops="{StaticResource AuroraStops}">
                                                    <LinearGradientBrush.Transform>
                                                        <TranslateTransform x:Name="TintShiftT" />
                                                    </LinearGradientBrush.Transform>
                                                </LinearGradientBrush>
                                            </Path.Fill>
                                        </Path>
                                    </Canvas>
                                </Canvas>
                            </Canvas>
                            <Canvas Clip="{StaticResource Clip.R}">
                                <Path Data="{StaticResource Logo.Aart}" Fill="{StaticResource LogoBlue}" />
                                <Path x:Name="TintR" Data="{StaticResource Logo.Aart}" Opacity="0">
                                    <Path.Fill>
                                        <LinearGradientBrush MappingMode="Absolute" StartPoint="160,0" EndPoint="630,0" GradientStops="{StaticResource AuroraStops}">
                                            <LinearGradientBrush.Transform>
                                                <TranslateTransform x:Name="TintShiftR" />
                                            </LinearGradientBrush.Transform>
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                </Path>
                            </Canvas>
                        </Canvas>
                    </Canvas>
                    <Canvas Clip="{StaticResource Clip.A2}">
                        <Path Data="{StaticResource Logo.Aart}" Fill="{StaticResource LogoBlue}" />
                        <Path x:Name="TintA2" Data="{StaticResource Logo.Aart}" Opacity="0">
                            <Path.Fill>
                                <LinearGradientBrush MappingMode="Absolute" StartPoint="160,0" EndPoint="630,0" GradientStops="{StaticResource AuroraStops}">
                                    <LinearGradientBrush.Transform>
                                        <TranslateTransform x:Name="TintShiftA2" />
                                    </LinearGradientBrush.Transform>
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Canvas>
                </Canvas>
            </Canvas>
            <Canvas Clip="{StaticResource Clip.A1}">
                <Path Data="{StaticResource Logo.Aart}" Fill="{StaticResource LogoBlue}" />
                <Path x:Name="TintA1" Data="{StaticResource Logo.Aart}" Opacity="0">
                    <Path.Fill>
                        <LinearGradientBrush MappingMode="Absolute" StartPoint="160,0" EndPoint="630,0" GradientStops="{StaticResource AuroraStops}">
                            <LinearGradientBrush.Transform>
                                <TranslateTransform x:Name="TintShiftA1" />
                            </LinearGradientBrush.Transform>
                        </LinearGradientBrush>
                    </Path.Fill>
                </Path>
            </Canvas>
        </Canvas>
    </Canvas>
</Canvas>
