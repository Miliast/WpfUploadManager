<!--
    Taskbar hover preview (Paper 7b · "Detail on demand"): the small card Windows shows above the taskbar button.
    It is never placed in a window – MainWindow renders it to a bitmap when Windows asks for the thumbnail.
      Multi mode  – total count, failed / aborted, total bar, one row per node
      Single mode – count, time left, bar, node name + the test that is running
    Texts and the total bar are filled in TaskbarPreview.xaml.cs; the node rows bind to PipelineNode.
-->
<UserControl x:Class="Conduit.TaskbarPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Conduit"
             Width="252"
             FontFamily="{StaticResource Sans}" FontSize="12"
             Foreground="{StaticResource Ink}"
             UseLayoutRounding="True">

    <UserControl.Resources>
        <!-- Status colour of a node: green, amber once tests were aborted, red once one failed. -->
        <Style x:Key="NodeColour" TargetType="Shape">
            <Setter Property="Fill" Value="{StaticResource Green}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAborted}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Amber}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Red}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One node: dot · name · bar · done/total -->
        <DataTemplate x:Key="NodeRow" DataType="{x:Type local:PipelineNode}">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="86" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Ellipse Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center" Style="{StaticResource NodeColour}" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" LineHeight="16"
                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                <Border Grid.Column="2" Height="4" CornerRadius="2" VerticalAlignment="Center"
                        Background="{StaticResource Track}" local:Look.ClipToCorners="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Done, Converter={StaticResource Star}}" />
                            <ColumnDefinition Width="{Binding Rest, Converter={StaticResource Star}}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Style="{StaticResource NodeColour}" />
                    </Grid>
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding ProgressText}" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border Background="{StaticResource White}" CornerRadius="6" Padding="14">
        <StackPanel>
            <!-- "72 of 160   1 failed   2 aborted"  /  "24 of 50   ~0:34 left" -->
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CountText" FontSize="22" FontWeight="Bold" LineHeight="26" LineStackingStrategy="BlockLineHeight" />
                <TextBlock x:Name="FailedText" FontWeight="SemiBold" Foreground="{StaticResource RedText}"
                           VerticalAlignment="Bottom" Margin="10,0,0,4" />
                <TextBlock x:Name="NoteText" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,4" />
            </StackPanel>

            <!-- Total progress -->
            <Border Height="4" CornerRadius="2" Margin="0,12,0,0" Background="{StaticResource Track}" local:Look.ClipToCorners="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="TotalDone" Width="0*" />
                        <ColumnDefinition x:Name="TotalRest" Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="TotalFill" Fill="{StaticResource Green}" />
                </Grid>
            </Border>

            <!-- Multi mode: every node at a glance -->
            <ItemsControl x:Name="NodeRows" ItemTemplate="{StaticResource NodeRow}" Margin="0,4,0,0" Focusable="False" />

            <!-- Single mode: "Payments · now running" + the test in flight -->
            <StackPanel x:Name="SinglePanel" Margin="0,12,0,0">
                <TextBlock x:Name="SingleTitle" FontSize="13" FontWeight="SemiBold" LineHeight="16" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SingleSub" Foreground="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
