<!--
    TaskbarPreview – the card Windows shows above the taskbar button while you hover it
    (Paper "7c · Taskbar preview — clean rebuild", option B: one bar, one section per node).

        ╭────────────────────────────────────────────────╮
        │ ■ Run #1042                            ● 0:47  │   header: logo 18 · run · live dot · elapsed (mono)
        │                                                │
        │ 72 of 160 done                 about 0:34 left │   count 34 Bold · unit 14 Subtle · right note 12 Subtle
        │                                                │
        │ ▰▰▰▰▱▱▱▱▱   ▰▰▰▱▱▱▱▱▱▱▱   ▰▰▰▰▰▰▱▱▱▱           │   one bar per node, 8 high, 4 px apart;
        │ Payments    Formatting    Queue worker         │   each section is as wide as its share of the tests
        │ 24/50       18/60         30/50                │   name 12 SemiBold · done/total mono 11
        │ 1 failed                  1 aborted            │   problem line 11 SemiBold, only when there is one
        ╰────────────────────────────────────────────────╯

    Why sections instead of one total bar: the nodes run side by side, so a single bar from left to right would
    describe a sequence that does not exist. Here every node fills its own section, and a failure is visible in the
    node it belongs to (a failed or aborted piece is never thinner than 5 px, so one test in fifty still shows).

    The card is never placed in a window. MainWindow asks Render() for a picture of it whenever Windows wants the
    thumbnail, so there is no motion here – every render shows the numbers of that moment.
      · texts of header and count row ........ filled in TaskbarPreview.xaml.cs
      · sections ............................. one "NodeSection" per node, added in TaskbarPreview.xaml.cs
                                               (the column widths are the nodes' test counts)
      · colours and fonts .................... App.xaml
-->
<UserControl x:Class="Conduit.TaskbarPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Conduit"
             Width="320"
             FontFamily="{StaticResource Sans}" FontSize="12"
             Foreground="{StaticResource Ink}"
             UseLayoutRounding="True">

    <UserControl.Resources>

        <!-- A failed / aborted piece of a node's bar: its share of the bar, but at least 5 px once there is one. -->
        <Style x:Key="FailedColumn" TargetType="ColumnDefinition">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                    <Setter Property="MinWidth" Value="5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AbortedColumn" TargetType="ColumnDefinition">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasAborted}" Value="True">
                    <Setter Property="MinWidth" Value="5" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            One node = one section:
              bar ........ 8 high, radius 4, Track behind; passed green | failed red | aborted amber | rest empty
              name ....... 8 below the bar, 12 SemiBold, cut with … when the section is narrow
              count ...... "24/50", mono 11, Subtle
              problem .... "1 failed" in red; or, when nothing failed, "1 aborted" in amber; otherwise no line
        -->
        <DataTemplate x:Key="NodeSection" DataType="{x:Type local:PipelineNode}">
            <StackPanel>
                <Border Height="8" CornerRadius="4" Background="{StaticResource Track}" local:Look.ClipToCorners="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Passed, Converter={StaticResource Star}}" />
                            <ColumnDefinition Width="{Binding Failed, Converter={StaticResource Star}}" Style="{StaticResource FailedColumn}" />
                            <ColumnDefinition Width="{Binding Aborted, Converter={StaticResource Star}}" Style="{StaticResource AbortedColumn}" />
                            <ColumnDefinition Width="{Binding Rest, Converter={StaticResource Star}}" />
                        </Grid.ColumnDefinitions>
                        <Rectangle Fill="{StaticResource Green}" />
                        <Rectangle Grid.Column="1" Fill="{StaticResource Red}" />
                        <Rectangle Grid.Column="2" Fill="{StaticResource Amber}" />
                    </Grid>
                </Border>

                <TextBlock Text="{Binding Name}" Margin="0,8,0,0" FontWeight="SemiBold" LineHeight="16" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding ProgressText}" Margin="0,1,0,0" FontFamily="{StaticResource Mono}" FontSize="11"
                           Foreground="{StaticResource Subtle}" />

                <TextBlock x:Name="Problem" Margin="0,1,0,0" FontSize="11" FontWeight="SemiBold" Visibility="Collapsed"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <DataTemplate.Triggers>
                <!-- Order matters: a node with both shows the failure, because the later trigger wins. -->
                <DataTrigger Binding="{Binding HasAborted}" Value="True">
                    <Setter TargetName="Problem" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Problem" Property="Text" Value="{Binding Aborted, StringFormat={}{0} aborted}" />
                    <Setter TargetName="Problem" Property="Foreground" Value="{StaticResource AmberText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasFailed}" Value="True">
                    <Setter TargetName="Problem" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Problem" Property="Text" Value="{Binding Failed, StringFormat={}{0} failed}" />
                    <Setter TargetName="Problem" Property="Foreground" Value="{StaticResource RedText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- The card: white, 16 px padding. Windows frames the thumbnail itself, so only a small radius. -->
    <Border Background="{StaticResource White}" CornerRadius="8" Padding="16">
        <StackPanel>

            <!-- ── Header: logo · "Run #1042" ……… ● 0:47 ─────────────────────────────────────────────── -->
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="18" Height="18" CornerRadius="5" Background="{StaticResource Ink}">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Blue}" />
                </Border>
                <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" FontFamily="{StaticResource Mono}"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                <!-- Blue dot: the run is live. Hidden once it finished. -->
                <Ellipse x:Name="LiveDot" DockPanel.Dock="Right" Width="6" Height="6" Margin="0,0,8,0"
                         Fill="{StaticResource Blue}" VerticalAlignment="Center" />
                <TextBlock x:Name="RunText" Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- ── Count row: "72 of 160 done" ……… "about 0:34 left" ─────────────────────────────────── -->
            <DockPanel Margin="0,14,0,0">
                <TextBlock x:Name="NoteText" DockPanel.Dock="Right" Foreground="{StaticResource Subtle}"
                           VerticalAlignment="Bottom" Margin="8,0,0,6" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="CountText" FontSize="34" FontWeight="Bold" LineHeight="38" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock x:Name="UnitText" FontSize="14" Foreground="{StaticResource Subtle}"
                               VerticalAlignment="Bottom" Margin="6,0,0,6" />
                </StackPanel>
            </DockPanel>

            <!-- ── Sections: one column per node, 4 px apart. Columns and content are added in code. ── -->
            <Grid x:Name="Sections" Margin="0,14,0,0" />

            <!-- ── Single node only: the test that is running right now ─────────────────────────────── -->
            <TextBlock x:Name="NowText" Margin="0,10,0,0" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
    </Border>
</UserControl>
