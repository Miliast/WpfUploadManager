                <TextBlock Text="ESC" VerticalAlignment="Center" Style="{StaticResource Tiny}" />
                <Button Width="36" Height="36" Margin="10,0,0,0" Template="{StaticResource Bare}" Cursor="Hand" Click="OnViewerClose">
                    <Grid>
                        <Ellipse Fill="{StaticResource White}" Stroke="{StaticResource Line}" StrokeThickness="1" />
                        <local:PathIcon Data="{StaticResource Geo.Close}" Width="12" Height="12" StrokeThickness="1.4"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Button>
            </StackPanel>

            <Grid x:Name="ViewerPanel" MaxWidth="904" Margin="48,84,48,48" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <!-- the shadow lives on its own layer behind the panel -->
                <Border CornerRadius="22" Background="{StaticResource White}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="80" ShadowDepth="32" Direction="270" Color="#0B0D12" Opacity="0.18" />
                    </Border.Effect>
                </Border>
                <Border CornerRadius="22" Padding="12,12,12,20" Background="{StaticResource White}"
                        BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <StackPanel>
                        <Grid>
                            <Border x:Name="ViewerShape" CornerRadius="12" Background="{StaticResource Page}" />
                            <Image x:Name="ViewerImage" Stretch="Uniform" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                                <Image.OpacityMask>
                                    <VisualBrush Visual="{Binding ElementName=ViewerShape}" />
                                </Image.OpacityMask>
                            </Image>
                        </Grid>
                        <DockPanel Margin="10,18,10,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Caption}" Margin="40,5,0,0" VerticalAlignment="Top" Style="{StaticResource Tiny}" />
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold"
                                           LineHeight="26" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Text}" Margin="0,2,0,0" FontSize="15" Foreground="{StaticResource Muted}"
                                           LineHeight="24" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap"
                                           Visibility="{Binding Text, Converter={StaticResource VisibleWhen}}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
