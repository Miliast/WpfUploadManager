<!--
    WhatsNewWindow – the release timeline (Paper "v9 · Conduit What's New — badges in the date lane").

    This file is only the LOOK. It contains no release text at all: every word comes from Changelog.json,
    which WhatsNewWindow.xaml.cs reads when the window opens. A new release = a new block in that file, nothing here.

        ┌──────────────────────────────────────────────────────────────────────────────────┐
        │  What's new                                                  ● You're on 0.1.0   │  page header
        │                                                                                  │
        │  ◉  November 12, 2026      One switch for single and multiple tests.            │  ┐
        │  │  0.1.0                  Choose how you want to run …                          │  │
        │  │  [Feature] [Improve…]                                                         │  │
        │  │  [Bug fixes]            Mode switch                                           │  │ one release
        │  │                         A two-sided pill above the fields. …                  │  │ = one entry in
        │  │                         ╭ picture ───────────────────────────╮                │  │   Changelog.json
        │  │                         ╰────────────────────────────────────╯                │  │
        │  │                         Also new        • …                                   │  │
        │  │                         Improvements    • …                                   │  │
        │  │                         Fixes           • …                                   │  │
        │  │                         (o) Shipped by  Mili                                  │  ┘
        │  ○  November 9, 2026       Every node on its own tab.                           │
        │  │  0.0.9                  …                                                     │  every release uses the
        │  │  [Feature] [Bug fixes]                                                        │  same template
        │  •                         Show 0.0.7 and earlier ⌄                              │  "older" row
        └──────────────────────────────────────────────────────────────────────────────────┘

    Three lanes per release (the Grid in the template "Release"), 248 + rest:
      1. Rail ....... 27 wide: a 9 px slot with a 1 px grey line and the dot (13 px from the top), then 18 px air.
                      Dot: 9 px, white with a grey 1.5 px rim. The release being read has a blue dot with a pale ring.
      2. Date lane .. 221 wide: date (15/22 SemiBold), version (Mono 12/18, Muted), then the badges (wrap after 196 px).
      3. Body ....... the rest, at most 680 wide, 80 px empty below before the next release.
                      (The window is 1080 wide: 1040 as in Paper plus its own border and the scroll bar, so the body gets its 680.)

    The date STAYS while its release is being read (like a sticky header): WhatsNewWindow.xaml.cs pushes the parts
    named "Pin" (date lane) and "Node" (dot) down while the release scrolls out at the top, and stretches "Trail",
    a blue line that the dot draws behind itself. "NodeOn" is the blue look of the dot; it fades in and out.

    Body, top to bottom (36 px between the blocks):
      · headline ...... 28/36 Medium
      · summary ....... 15/24 Muted, 10 below the headline
      · picture ....... optional ("image" on the release), 24 below the summary
      · features ...... every "new" item with a text or picture: title 17/24 SemiBold, text 15/24, picture 18 below
      · lists ......... "Also new" (or "New"), "Improvements", "Fixes": title 17/24 SemiBold, then lines with a 5 px grey dot.
                        A list without items is not shown.
      · shipped by .... optional ("by"): round photos (36 px, overlapping by 10), "Shipped by", the names in handwriting.

    Badges: Feature (blue), Improvement (green) and Bug fixes (red) are worked out from the item types;
    words from "tags" follow in grey. Radius 7, text 12/18 Medium, 6 px between them.

    Not taken over from Paper: letter-spacing (WPF text has none) and the web font of the handwriting –
    "Hand" below falls back to handwriting fonts that ship with Windows.
-->
<Window x:Class="Conduit.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Conduit"
        Title="What's new"
        Width="1080" Height="860" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Icon="{StaticResource LogoImage}"
        FontFamily="{StaticResource Sans}" FontSize="13"
        Foreground="{StaticResource Ink}" Background="{StaticResource White}"
        UseLayoutRounding="True">

    <Window.Resources>

        <!-- Chevron of "Show … and earlier", drawn in a 12 × 12 box (PathIcon can scale up, not down). -->
        <Geometry x:Key="Geo.Chevron">M3,4.5 L6,7.5 L9,4.5</Geometry>

        <!-- The names after "Shipped by". Fonts that ship with Windows; put an own font first to change the hand. -->
        <FontFamily x:Key="Hand">Ink Free, Segoe Script, Segoe Print</FontFamily>

        <!-- 17/24 SemiBold: the title of a feature and of a list ("Improvements"). -->
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- 15/24: running text. A line break in the JSON text (\n) is shown as one. -->
        <Style x:Key="Copy" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Body}" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- A button that shows only its content ("Show … and earlier"). -->
        <ControlTemplate x:Key="Bare" TargetType="ButtonBase">
            <Border Background="Transparent">
                <ContentPresenter />
            </Border>
        </ControlTemplate>

        <!-- ── Badge under the date ──────────────────────────────────────────────────────────────────────────
             Padding 9 × 3, radius 7, text 12/18 Medium. 6 px to the next badge and to the next row.
             Grey by default (a word from "tags"); the three automatic kinds get their colour below. -->
        <DataTemplate x:Key="Badge" DataType="{x:Type local:Badge}">
            <Border x:Name="Pill" Margin="0,0,6,6" Padding="9,3" CornerRadius="7" Background="{StaticResource Chip}">
                <TextBlock x:Name="Word" Text="{Binding Text}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Muted}"
                           LineHeight="18" LineStackingStrategy="BlockLineHeight" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="feature">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource BlueChip}" />
                    <Setter TargetName="Word" Property="Foreground" Value="{StaticResource Blue}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="improvement">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource GreenSoft}" />
                    <Setter TargetName="Word" Property="Foreground" Value="{StaticResource GreenText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="fix">
                    <Setter TargetName="Pill" Property="Background" Value="{StaticResource RedSoft}" />
                    <Setter TargetName="Word" Property="Foreground" Value="{StaticResource RedText}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── Picture frame ─────────────────────────────────────────────────────────────────────────────────
             Its data is the address of the picture. Three layers: the grey shape (radius 14), the picture cut to
             that shape, and a hairline on top. A wide picture is scaled down to the body width; a small one keeps
             its size and sits in the middle of the grey. -->
        <DataTemplate x:Key="Picture">
            <Grid>
                <Border x:Name="Shape" CornerRadius="14" Background="{StaticResource Page}" />
                <Image Source="{Binding}" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=Shape}" />
                    </Image.OpacityMask>
                </Image>
                <Border CornerRadius="14" BorderBrush="{StaticResource Line}" BorderThickness="1" />
            </Grid>
        </DataTemplate>

        <!-- ── Feature: a "new" item with a text or picture. 36 px above, text 6 below the title, picture 18 below. ── -->
        <DataTemplate x:Key="Feature" DataType="{x:Type local:Change}">
            <StackPanel Margin="0,36,0,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Heading}" />
                <TextBlock Text="{Binding Text}" Margin="0,6,0,0" Style="{StaticResource Copy}"
                           Visibility="{Binding Text, Converter={StaticResource VisibleWhen}}" />
                <ContentPresenter Margin="0,18,0,0" Content="{Binding Picture}" ContentTemplate="{StaticResource Picture}"
                                  Visibility="{Binding Picture, Converter={StaticResource VisibleWhen}}" />
            </StackPanel>
        </DataTemplate>

        <!-- ── One list line: [dot 5] 12 [text 15/24]. The dot sits on the first text line. 8 px above. ── -->
        <DataTemplate x:Key="Bullet" DataType="{x:Type local:Change}">
            <DockPanel Margin="0,8,0,0">
                <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="0,10,12,0" VerticalAlignment="Top" Fill="{StaticResource Faint}" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Copy}" />
            </DockPanel>
        </DataTemplate>

        <!-- ── Face in "Shipped by": a 36 px photo with a white 2 px ring (40 in total).
             Every face moves 10 px over the one before it. No photo → the first letter on grey. ── -->
        <DataTemplate x:Key="Face" DataType="{x:Type local:Author}">
            <Grid Width="40" Height="40" Margin="-10,0,0,0" ToolTip="{Binding Name}">
                <Ellipse Fill="{StaticResource White}" />
                <Ellipse Margin="2" Fill="{StaticResource Chip}" />
                <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Ellipse Margin="2" RenderOptions.BitmapScalingMode="HighQuality"
                         Visibility="{Binding Photo, Converter={StaticResource VisibleWhen}}">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding Photo}" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>
        </DataTemplate>

        <!-- ══ One release: rail | date lane | body ═══════════════════════════════════════════════════════════
             The names Pin, Node, NodeOn and Trail are used by WhatsNewWindow.xaml.cs for the date that stays. -->
        <DataTemplate x:Key="Release" DataType="{x:Type local:Release}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="221" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 1 · Rail: line down to the next release, blue trail (1 px tall, stretched from code), dot on top -->
                <Grid Width="9" HorizontalAlignment="Left">
                    <Rectangle x:Name="Line" Width="1" HorizontalAlignment="Center" Fill="{StaticResource SkeletonLight}" />
                    <Rectangle x:Name="Trail" Width="1" Height="1" Margin="0,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top"
                               Fill="{StaticResource Blue}" />
                    <Grid x:Name="Node" Width="9" Height="9" Margin="0,13,0,0" VerticalAlignment="Top">
                        <!-- resting look: white 4 px halo (it interrupts the line), grey rim -->
                        <Ellipse Margin="-4" Fill="{StaticResource White}" />
                        <Ellipse Fill="{StaticResource White}" Stroke="{StaticResource Faint}" StrokeThickness="1.5" />
                        <!-- the release being read: pale 1 px ring, white 4 px halo, blue dot -->
                        <Grid x:Name="NodeOn" Opacity="0">
                            <Ellipse Margin="-5" Fill="{StaticResource BlueRing}" />
                            <Ellipse Margin="-4" Fill="{StaticResource White}" />
                            <Ellipse Fill="{StaticResource Blue}" />
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 2 · Date lane: 6 px down so the date sits on the line of the headline -->
                <StackPanel x:Name="Pin" Grid.Column="1" Margin="0,6,0,0" VerticalAlignment="Top">
                    <TextBlock Text="{Binding DateText}" FontSize="15" FontWeight="SemiBold" LineHeight="22" LineStackingStrategy="BlockLineHeight" />
                    <TextBlock Text="{Binding Version}" Margin="0,3,0,0" FontFamily="{StaticResource Mono}" FontSize="12"
                               Foreground="{StaticResource Muted}" LineHeight="18" LineStackingStrategy="BlockLineHeight" />
                    <!-- 196 px of badges + the 6 px every badge carries on its right; -6 eats the gap under the last row -->
                    <ItemsControl Width="202" Margin="0,10,0,-6" HorizontalAlignment="Left" ItemsSource="{Binding Badges}"
                                  ItemTemplate="{StaticResource Badge}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <!-- 3 · Body -->
                <StackPanel Grid.Column="2" MaxWidth="680" Margin="0,0,0,80" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Headline}" FontSize="28" FontWeight="Medium"
                               LineHeight="36" LineStackingStrategy="BlockLineHeight" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Summary}" Margin="0,10,0,0" Style="{StaticResource Copy}" Foreground="{StaticResource Muted}" />
                    <ContentPresenter Margin="0,24,0,0" Content="{Binding Picture}" ContentTemplate="{StaticResource Picture}"
                                      Visibility="{Binding Picture, Converter={StaticResource VisibleWhen}}" />

                    <ItemsControl ItemsSource="{Binding Features}" ItemTemplate="{StaticResource Feature}" Focusable="False" />

                    <!-- The three lists share one build: title, 2 px, then the lines (each brings 8 px above itself). -->
                    <StackPanel Margin="0,36,0,0" Visibility="{Binding NewList, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="{Binding NewLabel}" Style="{StaticResource Heading}" />
                        <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding NewList}" ItemTemplate="{StaticResource Bullet}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Margin="0,36,0,0" Visibility="{Binding Improvements, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Improvements" Style="{StaticResource Heading}" />
                        <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Improvements}" ItemTemplate="{StaticResource Bullet}" Focusable="False" />
                    </StackPanel>
                    <StackPanel Margin="0,36,0,0" Visibility="{Binding Fixes, Converter={StaticResource VisibleWhen}}">
                        <TextBlock Text="Fixes" Style="{StaticResource Heading}" />
                        <ItemsControl Margin="0,2,0,0" ItemsSource="{Binding Fixes}" ItemTemplate="{StaticResource Bullet}" Focusable="False" />
                    </StackPanel>

                    <!-- Shipped by: [faces] 12 "Shipped by" 9 [names]. The faces start 8 px in because the first one
                         also moves 10 px left and carries its 2 px ring. Hidden when the release names nobody. -->
                    <StackPanel Margin="0,40,0,0" Orientation="Horizontal" Visibility="{Binding Authors, Converter={StaticResource VisibleWhen}}">
                        <ItemsControl Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding Authors}"
                                      ItemTemplate="{StaticResource Face}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                        <TextBlock Text="Shipped by" Margin="10,0,0,0" FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ByText}" Margin="9,0,0,0" FontFamily="{StaticResource Hand}" FontSize="24" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- The newest release is the top of the rail: its line starts under the dot instead of above it,
                 and its dot is the blue one when the window opens (the code moves the blue on while scrolling). -->
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLatest}" Value="True">
                    <Setter TargetName="Line" Property="Margin" Value="0,18,0,0" />
                    <Setter TargetName="NodeOn" Property="Opacity" Value="1" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                  ScrollChanged="OnScrolled">
        <StackPanel Margin="56,48,56,56">

            <!-- ── Page header: title 30/36 on the left, "You're on x" on its baseline at the right. 56 px to the timeline. ── -->
            <DockPanel Margin="0,0,0,56">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,5">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" />
                    <TextBlock x:Name="CurrentVersion" Margin="8,0,0,0" Style="{StaticResource MonoText}" Foreground="{StaticResource Muted}" />
                </StackPanel>
                <TextBlock Text="What's new" FontSize="30" FontWeight="SemiBold" LineHeight="36" LineStackingStrategy="BlockLineHeight" />
            </DockPanel>

            <!-- ── Timeline: one "Release" template per entry of Changelog.json (filled in WhatsNewWindow.xaml.cs). ── -->
            <ItemsControl x:Name="Timeline" ItemTemplate="{StaticResource Release}" Focusable="False" />

            <!-- ── "Show 0.0.7 and earlier": same lanes. The rail ends here: 10 px of line, then a small grey dot.
                 Hidden once everything is shown. ── -->
            <Grid x:Name="OlderRow">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="27" />
                    <ColumnDefinition Width="221" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="9" Height="24" HorizontalAlignment="Left">
                    <Rectangle Width="1" Height="10" HorizontalAlignment="Center" VerticalAlignment="Top" Fill="{StaticResource SkeletonLight}" />
                    <Ellipse Width="5" Height="5" Margin="0,10,0,0" VerticalAlignment="Top" Fill="{StaticResource Dot}" />
                </Grid>
                <Button Grid.Column="2" HorizontalAlignment="Left" Template="{StaticResource Bare}" Cursor="Hand" Click="OnShowOlder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="OlderText" FontSize="15" FontWeight="Medium" LineHeight="24" LineStackingStrategy="BlockLineHeight" />
                        <local:PathIcon Data="{StaticResource Geo.Chevron}" Box="12" Width="13" Height="13" StrokeThickness="1.3" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Window>
