<!--
    GlowSweep – aurora glow for auto-fill (look lives here, motion in GlowSweep.xaml.cs).
    Everything the glow is made of is defined below as a template; x:Shared="False" hands out a fresh copy
    on every FindResource, so several glows can play at the same time.
    The code-behind only places the shapes (button → fields) and starts the animations.
-->
<Canvas x:Class="Conduit.GlowSweep"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        IsHitTestVisible="False"
        ClipToBounds="True">

    <Canvas.Resources>

        <!-- ── Palette ─────────────────────────────────────────────────── -->
        <Color x:Key="Violet">#7C5CFF</Color>
        <Color x:Key="Pink">#FF4FA3</Color>
        <Color x:Key="Orange">#FF9248</Color>
        <Color x:Key="Indigo">#3D6BFF</Color>

        <!-- Soft light blobs: full colour in the middle, nothing at the rim (alpha 50 % → 22 % → 0). -->
        <RadialGradientBrush x:Key="BlobViolet">
            <GradientStop Color="#807C5CFF" Offset="0" />
            <GradientStop Color="#3A7C5CFF" Offset="0.4" />
            <GradientStop Color="#007C5CFF" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BlobPink">
            <GradientStop Color="#80FF4FA3" Offset="0" />
            <GradientStop Color="#3AFF4FA3" Offset="0.4" />
            <GradientStop Color="#00FF4FA3" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BlobOrange">
            <GradientStop Color="#80FF9248" Offset="0" />
            <GradientStop Color="#3AFF9248" Offset="0.4" />
            <GradientStop Color="#00FF9248" Offset="1" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="BlobIndigo">
            <GradientStop Color="#803D6BFF" Offset="0" />
            <GradientStop Color="#3A3D6BFF" Offset="0.4" />
            <GradientStop Color="#003D6BFF" Offset="1" />
        </RadialGradientBrush>

        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <CubicEase x:Key="EaseInOut" EasingMode="EaseInOut" />

        <!-- ── 1. Flare: bright pulse right on the button ──────────────── -->
        <Ellipse x:Key="Flare" x:Shared="False" Width="240" Height="240" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#BFFF4FA3" Offset="0" />
                    <GradientStop Color="#56FF4FA3" Offset="0.4" />
                    <GradientStop Color="#00FF4FA3" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <ScaleTransform ScaleX="0.2" ScaleY="0.2" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Storyboard x:Key="FlareIn" x:Shared="False">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.2" To="1.6" Duration="0:0:0.7" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.2" To="1.6" Duration="0:0:0.7" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.7">
                <LinearDoubleKeyFrame Value="0" KeyTime="0%" />
                <SplineDoubleKeyFrame Value="1" KeyTime="12%" KeySpline="0.4,0 0.2,1" />
                <SplineDoubleKeyFrame Value="0" KeyTime="100%" KeySpline="0.4,0 0.2,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <!-- ── 2. Wash: tilted band of colour that sweeps across the page ── -->
        <Rectangle x:Key="Wash" x:Shared="False" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#007C5CFF" Offset="0" />
                    <GradientStop Color="#297C5CFF" Offset="0.3" />
                    <GradientStop Color="#38FF4FA3" Offset="0.55" />
                    <GradientStop Color="#24FF9248" Offset="0.75" />
                    <GradientStop Color="#00FF9248" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <SkewTransform AngleX="-14" />
                    <TranslateTransform />
                </TransformGroup>
            </Rectangle.RenderTransform>
        </Rectangle>

        <!-- ── 3. Blob: one aurora light (Fill = one of the Blob* brushes) ── -->
        <Ellipse x:Key="Blob" x:Shared="False" Opacity="0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="0.15" ScaleY="0.15" />
                    <TranslateTransform />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- ── 4. Land: glowing outline on a field when its file drops in ── -->
        <Border x:Key="LandRing" x:Shared="False" Opacity="0" BorderThickness="2" Background="#127C5CFF" RenderTransformOrigin="0.5,0.5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="{StaticResource Violet}" Offset="0" />
                    <GradientStop Color="{StaticResource Pink}" Offset="0.5" />
                    <GradientStop Color="{StaticResource Orange}" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
            <Border.Effect>
                <DropShadowEffect Color="{StaticResource Pink}" BlurRadius="28" ShadowDepth="0" Opacity="0.7" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.97" ScaleY="0.97" />
            </Border.RenderTransform>
        </Border>

        <Storyboard x:Key="LandIn" x:Shared="False">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.97" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.97" To="1" Duration="0:0:0.35" EasingFunction="{StaticResource EaseOut}" />
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity" Duration="0:0:0.95">
                <LinearDoubleKeyFrame Value="0" KeyTime="0%" />
                <SplineDoubleKeyFrame Value="1" KeyTime="15%" KeySpline="0.4,0 0.2,1" />
                <SplineDoubleKeyFrame Value="1" KeyTime="45%" KeySpline="0.4,0 0.2,1" />
                <SplineDoubleKeyFrame Value="0" KeyTime="100%" KeySpline="0.4,0 0.2,1" />
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

    </Canvas.Resources>
</Canvas>
