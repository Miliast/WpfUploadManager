<!--
    Screens 1 + 2 (Setup): project sidebar (empty → file tree) and the five input fields + "Get data from X".
    Files can be dragged from the tree or from Explorer onto a field or anywhere on the page.
-->
<UserControl x:Class="Conduit.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Conduit"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:Workspace}"
             d:DesignWidth="1280" d:DesignHeight="744">

    <UserControl.Resources>

        <!-- Skeleton line of the empty-sidebar illustration. -->
        <Style x:Key="SkeletonBar" TargetType="Border">
            <Setter Property="Height" Value="7" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>

        <!-- ── Sidebar tree row (screen 2) ─────────────────────────────────── -->
        <DataTemplate x:Key="TreeRowTemplate" DataType="{x:Type local:TreeRow}">
            <Border x:Name="Row" Height="28" CornerRadius="6" Padding="8,0" Margin="0,0,0,1"
                    MouseLeftButtonDown="OnTreeRowDown" MouseMove="OnTreeRowMove" MouseLeftButtonUp="OnTreeRowUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Cursor" Value="SizeAll" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{StaticResource Chip}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDir}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Border DockPanel.Dock="Left" Width="{Binding Indent}" />
                    <local:PathIcon x:Name="Chevron" DockPanel.Dock="Left" Data="{StaticResource Geo.ChevronRight}" Box="10" Width="10" Height="10"
                                    StrokeThickness="1.4" Foreground="{StaticResource Subtle}" />
                    <local:PathIcon x:Name="Glyph" DockPanel.Dock="Left" Box="16" Width="14" Height="14" Margin="6,0,0,0"
                                    Data="{StaticResource Geo.Doc}" Foreground="{StaticResource Green}" />
                    <TextBlock x:Name="Note" DockPanel.Dock="Right" Text="{Binding Note}" Margin="8,0,0,0" FontSize="11" FontWeight="Medium"
                               Foreground="{StaticResource Subtle}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Label" Text="{Binding Name}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDir}" Value="False">
                    <Setter TargetName="Chevron" Property="Visibility" Value="Hidden" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDir}" Value="True">
                    <Setter TargetName="Label" Property="FontWeight" Value="Medium" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Geo.ChevronDown}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding NoteIsCount}" Value="True">
                    <Setter TargetName="Note" Property="FontFamily" Value="{StaticResource Mono}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="Folder">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Folder}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Muted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="TestFolder">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Folder}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Glyph" Property="Filled" Value="True" />
                    <Setter TargetName="Chevron" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="Spec">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Spec}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Purple}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="Container">
                    <Setter TargetName="Glyph" Property="Data" Value="{StaticResource Geo.Container}" />
                    <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource Blue}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── One input field (40 px glyph · title/subtitle · Add / Replace) ── -->
        <DataTemplate x:Key="FieldTemplate" DataType="{x:Type local:Slot}">
            <StackPanel>
                <Border x:Name="Divider" Height="1" Margin="72,0,16,0" Background="{StaticResource LineSoft}" />
                <Border x:Name="Row" Height="68" CornerRadius="14" Padding="16,0" BorderThickness="1.5" BorderBrush="Transparent"
                        Background="Transparent" AllowDrop="True"
                        DragOver="OnFieldDragOver" DragLeave="OnFieldDragLeave" Drop="OnFieldDrop">
                    <DockPanel>

                        <!-- Glyph: blue folder / document with a coloured type tag; dashed outline while empty. -->
                        <Grid DockPanel.Dock="Left" Width="40" Height="40">
                            <Grid x:Name="FolderGlyph" Height="34" Visibility="Collapsed">
                                <Grid x:Name="FolderFull">
                                    <Rectangle Width="18" Height="10" RadiusX="3" RadiusY="3" Fill="{StaticResource BlueLight}"
                                               HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Rectangle Height="29" RadiusX="7" RadiusY="7" VerticalAlignment="Bottom">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#5A7BFF" Offset="0" />
                                                <GradientStop Color="#1F4BFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Effect>
                                            <DropShadowEffect Color="#1F4BFF" BlurRadius="6" ShadowDepth="2" Direction="270" Opacity="0.35" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </Grid>
                                <Grid x:Name="FolderEmpty" Visibility="Collapsed">
                                    <Rectangle Width="18" Height="10" RadiusX="3" RadiusY="3" Stroke="{StaticResource Dashed}" StrokeThickness="1.5"
                                               StrokeDashArray="2 1.4" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Rectangle Height="29" RadiusX="7" RadiusY="7" VerticalAlignment="Bottom" Fill="White"
                                               Stroke="{StaticResource Dashed}" StrokeThickness="1.5" StrokeDashArray="2 1.4" />
                                </Grid>
                            </Grid>

                            <Grid x:Name="FileGlyph">
                                <Border x:Name="Page" Width="30" Height="38" CornerRadius="6" Background="White"
                                        BorderBrush="{StaticResource Hairline}" BorderThickness="1" Padding="6,7">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="2" Direction="270" Color="#0B0D12" Opacity="0.06" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <Border Width="14" Height="2" CornerRadius="1" Background="{StaticResource Line}" HorizontalAlignment="Left" />
                                        <Border Width="10" Height="2" CornerRadius="1" Background="{StaticResource Line}" HorizontalAlignment="Left" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Border>
                                <Rectangle x:Name="PageEmpty" Width="30" Height="38" RadiusX="6" RadiusY="6" Visibility="Collapsed"
                                           Stroke="{StaticResource Dashed}" StrokeThickness="1.5" StrokeDashArray="2 1.4" />
                                <Border x:Name="TypeTag" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,6"
                                        Padding="4,2" CornerRadius="4" Background="{Binding TagColor}">
                                    <TextBlock x:Name="TypeText" Text="{Binding Tag}" FontSize="8" FontWeight="Bold" Foreground="White" />
                                </Border>
                            </Grid>
                        </Grid>

                        <Grid x:Name="Action" DockPanel.Dock="Right" VerticalAlignment="Center">
                            <Button x:Name="AddButton" Style="{StaticResource Btn.Chip}" Width="96" Height="30" Padding="0"
                                    Content="{Binding ActionText}" Click="OnBrowseField" />
                            <Button x:Name="ReplaceButton" Style="{StaticResource Btn.LinkMuted}" Content="Replace" Padding="4"
                                    Visibility="Collapsed" Click="OnBrowseField" />
                        </Grid>

                        <StackPanel VerticalAlignment="Center" Margin="16,0">
                            <TextBlock x:Name="Title" Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Subtitle" Text="{Binding Subtitle}" Margin="0,2,0,0" Foreground="{StaticResource Subtle}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Index}" Value="0">
                    <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" />
                    <Setter TargetName="FileGlyph" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFilled}" Value="False">
                    <Setter TargetName="FolderFull" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="FolderEmpty" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Page" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="PageEmpty" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TypeTag" Property="Background" Value="{StaticResource Line}" />
                    <Setter TargetName="TypeText" Property="Foreground" Value="{StaticResource Subtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                    <Setter TargetName="AddButton" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="ReplaceButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource BlueSoft}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{StaticResource Blue}" />
                    <Setter TargetName="Title" Property="Foreground" Value="{StaticResource Blue}" />
                    <Setter TargetName="Subtitle" Property="Foreground" Value="{StaticResource Muted}" />
                    <Setter TargetName="Action" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Virtualised, pixel-scrolling list (the project tree can have thousands of rows). -->
        <Style x:Key="VirtualList" TargetType="ItemsControl">
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel>

            <!-- ══ Sidebar ═══════════════════════════════════════════════════ -->
            <Border DockPanel.Dock="Left" Width="300" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"
                    AllowDrop="True" DragOver="OnSidebarDragOver" Drop="OnSidebarDrop">
                <Grid>

                    <!-- Screen 1: no project yet. -->
                    <Grid Visibility="{Binding HasProject, Converter={StaticResource CollapsedWhen}}">
                        <TextBlock Text="PROJECT" Style="{StaticResource SectionLabel}" Margin="20,22,0,0"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" />

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24,0,24,40">
                            <!-- A file tree in skeleton form. -->
                            <StackPanel Width="150" Opacity="0.9" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="12" Height="10" CornerRadius="2" Background="{StaticResource Skeleton}" />
                                    <Border Width="70" Style="{StaticResource SkeletonBar}" Background="{StaticResource Skeleton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,7,0,0">
                                    <Border Width="10" Height="12" CornerRadius="2" Background="{StaticResource SkeletonLight}" />
                                    <Border Width="84" Style="{StaticResource SkeletonBar}" Background="{StaticResource SkeletonLight}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,7,0,0">
                                    <Border Width="10" Height="12" CornerRadius="2" Background="{StaticResource SkeletonLight}" />
                                    <Border Width="60" Style="{StaticResource SkeletonBar}" Background="{StaticResource SkeletonLight}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <Border Width="12" Height="10" CornerRadius="2" Background="{StaticResource Skeleton}" />
                                    <Border Width="52" Style="{StaticResource SkeletonBar}" Background="{StaticResource Skeleton}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="16,7,0,0">
                                    <Border Width="10" Height="12" CornerRadius="2" Background="{StaticResource SkeletonLight}" />
                                    <Border Width="76" Style="{StaticResource SkeletonBar}" Background="{StaticResource SkeletonLight}" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Open your project" Margin="0,16,0,0" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Browse its files here, then drag them onto the fields." Margin="0,6,0,0" MaxWidth="230"
                                       Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" LineHeight="19"
                                       HorizontalAlignment="Center" />

                            <Button Style="{StaticResource Btn.Dark}" Height="36" Padding="14,0,8,0" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Click="OnOpenFolder">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Open folder" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="5,1" CornerRadius="4" Background="#29FFFFFF" VerticalAlignment="Center">
                                        <TextBlock Text="Ctrl+O" FontFamily="{StaticResource Mono}" FontSize="11" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Btn.Link}" Content="Try a sample project" Margin="0,14,0,0" HorizontalAlignment="Center"
                                    ToolTip="Shift-click for single mode" Click="OnSample" />
                        </StackPanel>
                    </Grid>

                    <!-- Screen 2: the project's files. -->
                    <DockPanel Visibility="{Binding HasProject, Converter={StaticResource VisibleWhen}}">
                        <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Link}" Content="Replace" FontSize="12" FontWeight="SemiBold"
                                        ToolTip="Open another folder (Ctrl+O)" Click="OnOpenFolder" />
                                <local:PathIcon Data="{StaticResource Geo.Folder}" Box="16" Width="16" Height="16" Filled="True"
                                                Foreground="{StaticResource Blue}" />
                                <StackPanel Orientation="Horizontal" Margin="8,0,8,0" ClipToBounds="True">
                                    <TextBlock Text="{Binding ProjectName}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ProjectFilesText}" Margin="8,1,0,0" FontFamily="{StaticResource Mono}" FontSize="11"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>

                            <Border Height="30" Margin="0,10,0,0" Padding="10,0" CornerRadius="8" Background="White" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{StaticResource Line}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=FilterBox}" Value="True">
                                                <Setter Property="BorderBrush" Value="{StaticResource BlueRing}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <DockPanel>
                                    <local:PathIcon Data="{StaticResource Geo.Search}" Width="13" Height="13" StrokeThickness="1.4"
                                                    Foreground="{StaticResource Subtle}" />
                                    <Grid Margin="8,0,0,0">
                                        <TextBlock Text="Filter files" Foreground="{StaticResource Subtle}" VerticalAlignment="Center" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBox x:Name="FilterBox" Text="{Binding TreeFilter, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center"
                                                 FontSize="13" Foreground="{StaticResource Black}" CaretBrush="{StaticResource Blue}" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- Footer: auto-fill (when the tree has matches for empty fields) + drag hint. -->
                        <Border DockPanel.Dock="Bottom" Padding="16,14" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                            <StackPanel>
                                <Button x:Name="AutoFillButton" Style="{StaticResource Btn.Dark}" Height="36" Margin="0,0,0,12"
                                        Visibility="{Binding ShowAutoFill, Converter={StaticResource VisibleWhen}}"
                                        IsEnabled="{Binding CanAutoFill}" Click="OnAutoFill">
                                    <StackPanel Orientation="Horizontal">
                                        <local:PathIcon Data="{StaticResource Geo.Sparkle}" Width="13" Height="13" Filled="True" />
                                        <TextBlock Text="{Binding AutoFillText}" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <StackPanel Orientation="Horizontal" Margin="4,0,0,0">
                                    <local:PathIcon Data="{StaticResource Geo.Upload}" Foreground="{StaticResource Muted}" />
                                    <TextBlock Text="Drag files from here onto a field" Margin="8,0,0,0" FontSize="12"
                                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid>
                            <ItemsControl Style="{StaticResource VirtualList}" Padding="8,4,8,8"
                                          ItemsSource="{Binding TreeRows}" ItemTemplate="{StaticResource TreeRowTemplate}" />
                            <TextBlock Text="No matching files" Margin="20,8" VerticalAlignment="Top" Foreground="{StaticResource Subtle}"
                                       Visibility="{Binding NoTreeMatches, Converter={StaticResource VisibleWhen}}" />
                        </Grid>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ══ Page ══════════════════════════════════════════════════════ -->
            <Grid Background="{StaticResource Page}" AllowDrop="True" DragOver="OnPageDragOver" Drop="OnPageDrop">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="72,40,72,24" MaxWidth="960">

                        <!-- Heading + "5 / 5 files" counter -->
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Margin="24,0,0,2" VerticalAlignment="Bottom">
                                <TextBlock HorizontalAlignment="Right" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}">
                                    <Run Text="{Binding FilledCount, Mode=OneWay}" Foreground="{StaticResource Ink}" FontWeight="SemiBold" /><Run Text=" / 5 files" />
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Slots}" Margin="-2,8,-2,0" HorizontalAlignment="Right" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:Slot}">
                                            <Border x:Name="Segment" Width="28" Height="4" Margin="2,0" CornerRadius="2" Background="{StaticResource Line}" />
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsFilled}" Value="True">
                                                    <Setter TargetName="Segment" Property="Background" Value="{StaticResource Blue}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Set up the run." FontSize="36" FontWeight="Bold" />
                                <TextBlock Text="{Binding SetupSubtitle}" Margin="0,6,0,0" FontSize="14" Foreground="{StaticResource Muted}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>

                        <!-- The five fields -->
                        <Grid Margin="0,20,0,0">
                            <Border Style="{StaticResource CardShadow}" CornerRadius="20" />
                            <Border Style="{StaticResource Card}" CornerRadius="20" Padding="6">
                                <ItemsControl x:Name="Fields" ItemsSource="{Binding Slots}" ItemTemplate="{StaticResource FieldTemplate}" Focusable="False" />
                            </Border>
                        </Grid>

                        <!-- Get data from X -->
                        <Grid Margin="0,16,0,0">
                            <Border Style="{StaticResource CardShadowSmall}" CornerRadius="16" />
                            <Border Style="{StaticResource Card}" CornerRadius="16" Padding="22,14">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Left" Width="40" Height="40">
                                        <Border CornerRadius="10" Background="{StaticResource BlueTile}">
                                            <local:PathIcon Data="{StaticResource Geo.Cloud}" Box="18" Width="18" Height="18" StrokeThickness="1.5"
                                                            Foreground="{StaticResource Blue}" />
                                        </Border>
                                        <Grid Width="20" Height="20" Margin="0,0,-6,-6" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                              Visibility="{Binding XLoaded, Converter={StaticResource VisibleWhen}}">
                                            <Ellipse Fill="White" />
                                            <Ellipse Margin="2" Fill="{StaticResource Green}" />
                                            <local:PathIcon Data="{StaticResource Geo.Check8}" Box="8" Width="8" Height="8" StrokeThickness="1.5" Foreground="White" />
                                        </Grid>
                                    </Grid>

                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center">
                                        <Button Style="{StaticResource Btn.Outline}" Height="32" Padding="11,0,12,0" Click="OnFetchX"
                                                Visibility="{Binding XLoaded, Converter={StaticResource VisibleWhen}}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:PathIcon Data="{StaticResource Geo.Refresh}" Width="13" Height="13" StrokeThickness="1.4" />
                                                <TextBlock Text="Get X data" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Btn.Dark}" local:Look.CornerRadius="8" Height="32" Padding="11,0,12,0" Click="OnFetchX"
                                                IsEnabled="{Binding CanFetchX}" Visibility="{Binding XLoaded, Converter={StaticResource CollapsedWhen}}">
                                            <StackPanel Orientation="Horizontal">
                                                <local:PathIcon Data="{StaticResource Geo.Download}" Width="13" Height="13" StrokeThickness="1.4" />
                                                <TextBlock Text="{Binding XButtonText}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <StackPanel Margin="16,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding XTitle}" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding XSubtitle}" Margin="0,2,0,0" Foreground="{StaticResource Subtle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- Screen 1 tip, pinned to the bottom of the page. -->
                <Border Grid.Row="1" Margin="72,0,72,40" MaxWidth="960" Visibility="{Binding ShowTip, Converter={StaticResource VisibleWhen}}">
                    <StackPanel Orientation="Horizontal">
                        <local:PathIcon Data="{StaticResource Geo.Info}" Foreground="{StaticResource Subtle}" StrokeThickness="1.2" />
                        <TextBlock Text="Tip: open the whole project folder in the sidebar and we'll fill matching fields for you."
                                   Margin="8,0,0,0" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </DockPanel>

        <!-- Aurora glow of auto-fill, above sidebar and page. -->
        <local:GlowSweep x:Name="Glow" />
    </Grid>
</UserControl>
