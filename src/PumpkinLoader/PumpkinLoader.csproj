<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Pixel-pumpkin loading pill: plain C#, no XAML, no NuGet packages, 1 class (PixelPumpkinLoader).
    LOADER_DEMO switches on the little Main() inside the class, so the same file can be copied
    into another project (e.g. UploadManager.App) without a second entry point.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PumpkinLoader</RootNamespace>
    <AssemblyName>PumpkinLoader</AssemblyName>
    <DefineConstants>$(DefineConstants);LOADER_DEMO</DefineConstants>
    <!-- Lets the project compile on macOS/Linux; it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
